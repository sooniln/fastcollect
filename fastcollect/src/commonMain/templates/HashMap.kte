@file:Suppress("UnusedImport")

package io.github.sooniln.fastcollect.${keySubpackage}

import io.github.sooniln.fastcollect.FastIterator
import io.github.sooniln.fastcollect.MutableFastIterator
<% if (!isReferenceValue) { %>
import io.github.sooniln.fastcollect.${valueSubpackage}.Mutable${ValueType}Collection
import io.github.sooniln.fastcollect.${valueSubpackage}.Mutable${ValueType}Iterator
<% } %>
import kotlin.jvm.JvmOverloads
import kotlin.math.max
import kotlin.math.min

/**
 * A [HashMap](https://en.wikipedia.org/wiki/Hash_table) implementation for storing ${KeyType} to ${ValueType}
 * relationships.
 *
 * The [keys]/[values] mutable collections exposed by this class will throw [UnsupportedOperationException] on any
 * attempt to mutate the collection, EXCEPT that [MutableIterator.remove] will work as expected. Other mutation
 * operations should be made directly on the map rather than on the sub-collections.
 *
 * The entry [iterator] exposed by this class is a [FastIterator] - clients may not allow the returned entry to escape. See
 * the [FastIterator] documentation for more information.
 *
 * The [ensureCapacity]/[trimToSize] methods can be used to manage the size of the backing array.
 */
public class ${Name}HashMap${Generics} @JvmOverloads constructor(
    capacity: Int = DEFAULT_INITIAL_CAPACITY,
<% if (!isReferenceValue) { %>
    /** The default value should be the value that is ideally least likely to occur in the map. */
    override val defaultValue: ${ValueType} = ${DefaultValue}
<% } %>
) : AbstractMutable${Name}Map${Generics}() {

    init {
        require(capacity >= 0) { "Capacity must be >= 0" }
    }

    public constructor(map: ${Name}Map${Generics}): this() { putAll(map) }

    public constructor(map: Map<${KeyType}, ${ValueType}>): this() { putAll(map) }

    // when used in hashing mode, the last slot in the array is used to store the zero key/value respectively. when used
    // in array mode, there is no special handling for zero.
    private var keysArr = EMPTY_KEY_ARRAY
    private var mask = keysArr.mask()
<% if (!isReferenceValue) { %>
    private var valuesArr = EMPTY_VALUE_ARRAY
<% } else { %>
    @Suppress("UNCHECKED_CAST")
    private var valuesArr = EMPTY_VALUE_ARRAY as Array<${ValueType}?>

    private val defaultValue: ${ValueType}? = ${DefaultValue}
<% } %>

    override var size: Int = 0
        private set

    // use threshold to store the initial size before we allocate anything, after that it's the size at which we rehash
    private var threshold: Int = if (capacity == 0) DEFAULT_INITIAL_CAPACITY else capacity

    /**
     * Ensures that the map can hold at least given number of key/value pairs without any further resizing of the
     * backing array.
     */
    public fun ensureCapacity(capacity: Int) {
        require(capacity >= 0) { "The expected number of elements must be nonnegative" }
        if (keysArr === EMPTY_KEY_ARRAY) {
            threshold = capacity
        } else if (capacity > threshold) {
            rehash(capacity)
        }
    }

    /**
     * Reduces the size of the backing array to the minimum required to hold the current number of elements.
     */
    @Suppress("UNCHECKED_CAST", "USELESS_CAST")
    public fun trimToSize() {
        rehash(size)
    }

    override fun put(key: ${KeyType}, value: ${ValueType}): ${ValueType}${Nullable} {
        resizeIfNecessary()

        val keysArr = keysArr
        val valuesArr = valuesArr

        if (key == ZERO) {
            val endSlot = keysArr.endSlot()
            val oldValue = if (keysArr[endSlot] != ZERO) {
                keysArr[endSlot] = ZERO
                ++size
                defaultValue
            } else {
                valuesArr[endSlot]
            }
            valuesArr[endSlot] = value
            return oldValue
        }

        val mask = mask
        val rotVal = mask.rotVal()
        var slot = key.slot(mask, rotVal)
        var newKey = key
        var newValue: ${ValueType}${Nullable} = value
        var newKeySlotDistance = 0
        while (true) {
            when (val currKey = keysArr[slot]) {
                newKey -> {
                    val oldValue = valuesArr[slot]
                    valuesArr[slot] = newValue
                    return oldValue
                }
                ZERO -> {
                    keysArr[slot] = newKey
                    valuesArr[slot] = newValue
                    ++size
                    return defaultValue
                }
                else -> {
                    val currKeySlotDistance = currKey.slotDistance(slot, mask, rotVal)
                    if (newKeySlotDistance > currKeySlotDistance) {
                        val currValue = valuesArr[slot]
                        keysArr[slot] = newKey
                        valuesArr[slot] = newValue
                        newKey = currKey
                        newValue = currValue
                        newKeySlotDistance = currKeySlotDistance
                    }
                }
            }

            slot = slot.nextSlot(mask)
            ++newKeySlotDistance
        }
    }

    override fun remove(key: ${KeyType}): ${ValueType}${Nullable} {
        val slot = findSlot(key)
        if (slot >= 0) {
            val oldValue = valuesArr[slot]
            removeSlot(slot)
            return oldValue
        }

        return defaultValue
    }

    override fun clear() {
        if (keysArr !== EMPTY_KEY_ARRAY) {
            keysArr.fill(ZERO)
<% if (isReferenceValue) { %>
            valuesArr.fill(null)
<% } %>
            keysArr[keysArr.endSlot()] = NONZERO
        }
        size = 0
    }

    private fun findSlot(key: ${KeyType}): Int {
        val keysArr = keysArr

        if (key == ZERO) {
            val endSlot = keysArr.endSlot()
            return if (keysArr[endSlot] != ZERO) -1 else endSlot
        }

        val mask = mask
        val rotVal = mask.rotVal()
        var slot = key.slot(mask, rotVal)
        var slotDistance = 0
        while (true) {
            val currKey = keysArr[slot]
            if (currKey == key) {
                return slot
            } else if (currKey == ZERO ||
                    // checking whether the current slot distance is higher than our search distance allows us to early
                    // exit the search loop, but at a non-trivial cost in extra operations. this generally increases
                    // GetHit time and decreases GetMiss time. in order to optimize this further so that we can still
                    // get the benefit of early exiting without paying the full cost, we implement the following: check
                    // for early exit only once per cache line, when we're half way through the cache line. this doesn't
                    // penalize GetHit times much (as we can hopefully find the element before incurring the full cost)
                    // and still substantially reduces GetMiss times.
                    (slotDistance and CACHE_LINE_MASK == HALF_CACHE_LINE_SIZE
                        && currKey.slotDistance(slot, mask, rotVal) < slotDistance)) {
                return -1
            }

            slot = slot.nextSlot(mask)
            ++slotDistance
        }
    }

    private fun removeSlot(slot: Int) {
        val keysArr = keysArr
        val valuesArr = valuesArr

        val endSlot = keysArr.endSlot()
        if (slot == endSlot) {
            keysArr[endSlot] = NONZERO
<% if (isReferenceValue) { %>
            valuesArr[endSlot] = null
<% } %>
            --size
            return
        }

        val mask = mask
        val rotVal = mask.rotVal()

        // move all slots left until we hit a zero slot
        var currSlot = slot
        var nextSlot = currSlot.nextSlot(mask)
        var nextKey = keysArr[nextSlot]
        var nextValue = valuesArr[nextSlot]
        while (nextKey != ZERO && nextKey.slotDistance(nextSlot, mask, rotVal) > 0) {
            keysArr[currSlot] = nextKey
            valuesArr[currSlot] = nextValue

            currSlot = nextSlot
            nextSlot = nextSlot.nextSlot(mask)
            nextKey = keysArr[nextSlot]
            nextValue = valuesArr[nextSlot]
        }
        keysArr[currSlot] = ZERO
<% if (isReferenceValue) { %>
        valuesArr[currSlot] = null
<% } %>
        --size
    }

    override fun putAll(from: ${Name}Map${Generics}) {
        if (isEmpty() && from is ${Name}HashMap${Generics}) {
            initializeFrom(from)
        } else {
            ensureCapacity(max(size + (from.size shr 1), from.size))
            for (entry in from) {
                set(entry.key, entry.value)
            }
        }
    }

    override fun putAll(from: Map<out ${KeyType}, ${ValueType}>) {
        ensureCapacity(max(size + (from.size shr 1), from.size))
        for (entry in from) {
            set(entry.key, entry.value)
        }
    }

    private fun initializeFrom(from: ${Name}HashMap${Generics}) {
        check(isEmpty())

        if (from.isEmpty()) return

        keysArr = from.keysArr.copyOf()
        mask = from.mask
        valuesArr = from.valuesArr.copyOf()
        size = from.size
        threshold = from.threshold
    }

    private var _keys: Mutable${KeyType}Set? = null
    override val keys: Mutable${KeyType}Set get() {
        return _keys ?:
            object : Mutable${KeyType}Set {
                override val size: Int get() = this@${Name}HashMap.size
                override fun contains(element: ${KeyType}): Boolean = containsKey(element)
                override fun add(element: ${KeyType}): Boolean = throw UnsupportedOperationException()
                override fun remove(element: ${KeyType}): Boolean = throw UnsupportedOperationException()
                override fun iterator(): Mutable${KeyType}Iterator = KeyIterator()
                override fun clear() = throw UnsupportedOperationException()
            }
            .also { _keys = it }
    }

    private var _values: Mutable${ValueCollectionType}${Generics}? = null
    override val values: Mutable${ValueCollectionType}${Generics} get() {
        return _values ?:
<% if (!isReferenceValue) { %>
            object : Mutable${ValueType}Collection {
<% } else { %>
            object : AbstractMutable${ValueCollectionType}${Generics}() {
<% } %>
                override val size: Int get() = this@${Name}HashMap.size
                override fun contains(element: ${ValueType}): Boolean = containsValue(element)
                override fun add(element: ${ValueType}): Boolean = throw UnsupportedOperationException()
                override fun remove(element: ${ValueType}): Boolean = throw UnsupportedOperationException()
                override fun iterator(): Mutable${ValueIteratorType}${Generics} = ValueIterator()
                override fun clear() = throw UnsupportedOperationException()
            }
            .also { _values = it }
    }

    override fun containsKey(key: ${KeyType}): Boolean {
        return findSlot(key) >= 0
    }

    override fun containsValue(value: ${ValueType}): Boolean {
        val endSlot = keysArr.endSlot()
        if (valuesArr[endSlot] == value && keysArr[endSlot] == ZERO) return true

        var slot = 0
        while (slot < endSlot) {
            if (valuesArr[slot] == value && keysArr[slot] != ZERO) return true
            ++slot
        }
        return false
    }

    override fun get(key: ${KeyType}): ${ValueType}${Nullable} {
        val slot = findSlot(key)
        return if (slot >= 0) valuesArr[slot] else defaultValue
    }

    private fun resizeIfNecessary() {
        if (keysArr === EMPTY_KEY_ARRAY) {
            rehash(threshold)
        } else if (size >= threshold) {
            rehash(threshold shl 1)
        }
    }

    @Suppress("UNCHECKED_CAST", "USELESS_CAST")
    private fun rehash(capacity: Int) {
        check(capacity >= size)

        if (capacity == 0 && keysArr !== EMPTY_KEY_ARRAY) {
            keysArr = EMPTY_KEY_ARRAY
            mask = keysArr.mask()
<% if (!isReferenceValue) { %>
            valuesArr = EMPTY_VALUE_ARRAY
<% } else { %>
            valuesArr = EMPTY_VALUE_ARRAY as Array<${ValueType}?>
<% } %>
            threshold = DEFAULT_INITIAL_CAPACITY
            return
        }

        // for small capacities we force loadFactor to 1.0 to save memory (small array scans are likely to be fast)
        val actualLoadFactor = if (capacity <= FORCE_LOAD_FACTOR_MAX) 1f else .9f

        val newLength = arraySize(capacity, actualLoadFactor)
        if (keysArr.size == newLength) return

        val newKeysArr = ${KeyType}Array(newLength)
<% if (!isReferenceValue) { %>
        val newValuesArr = ${ValueType}Array(newLength)
<% } else { %>
        val newValuesArr = arrayOfNulls<Any>(newLength) as Array<${ValueType}?>
<% } %>
        val newMask = newKeysArr.mask()
        val newRotVal = newMask.rotVal()
        val newEndSlot = newKeysArr.endSlot()

        val oldEndSlot = keysArr.endSlot()
        for (slot in 0..<oldEndSlot) {
            val key = keysArr[slot]
            if (key != ZERO) putRehashing(newKeysArr, newValuesArr, newMask, newRotVal, key, valuesArr[slot])
        }
        newKeysArr[newEndSlot] = keysArr[oldEndSlot]
        newValuesArr[newEndSlot] = valuesArr[oldEndSlot]

        keysArr = newKeysArr
        mask = newMask
        valuesArr = newValuesArr

        // threshold must always maintain the invariant of at least 1 slot being open
        threshold = min((newEndSlot * actualLoadFactor).toInt(), newEndSlot - 1)
    }

    // we can assume key doesn't exist in array and that we never insert zero
<% if (!isReferenceValue) { %>
    private fun putRehashing(keysArr: ${KeyType}Array, valuesArr: ${ValueType}Array, mask: Int, rotVal: Int, key: ${KeyType}, value: ${ValueType}) {
<% } else { %>
    private fun putRehashing(keysArr: ${KeyType}Array, valuesArr: Array<${ValueType}?>, mask: Int, rotVal: Int, key: ${KeyType}, value: ${ValueType}?) {
<% } %>
        var slot = key.slot(mask, rotVal)
        var newKey = key
        var newValue = value
        var newKeySlotDistance = 0
        while (true) {
            val currKey = keysArr[slot]
            if (currKey == ZERO) {
                keysArr[slot] = newKey
                valuesArr[slot] = newValue
                return
            }

            val currKeySlotDistance = currKey.slotDistance(slot, mask, rotVal)
            if (newKeySlotDistance > currKeySlotDistance) {
                keysArr[slot] = newKey
                newKey = currKey
                val currValue = valuesArr[slot]
                valuesArr[slot] = newValue
                newValue = currValue
                newKeySlotDistance = currKeySlotDistance
            }

            slot = slot.nextSlot(mask)
            ++newKeySlotDistance
        }
    }

    override operator fun iterator(): MutableFastIterator<Mutable${Name}Map.MutableEntry${Generics}> = FastEntryIterator()

    private open inner class SlotIterator {
        val keysArr = this@${Name}HashMap.keysArr
        private val mask = this@${Name}HashMap.mask
        val valuesArr = this@${Name}HashMap.valuesArr

        private var slotsLeft = size

        private var slot = keysArr.endSlot()
        private var previousSlot = -1

        init {
            if (keysArr[slot] != ZERO && slotsLeft > 0) {
                decrement()
            }
        }

        fun hasNext(): Boolean {
            return slotsLeft > 0
        }

        fun nextSlot() {
            if (slotsLeft-- <= 0) throw NoSuchElementException()
            previousSlot = slot
            if (slotsLeft > 0) decrement()
        }

        fun slot(): Int = previousSlot.also { check(it != -1) }
        fun key(): ${KeyType} = keysArr[previousSlot]
        @Suppress("UNCHECKED_CAST", "USELESS_CAST")
        fun value(): ${ValueType} = valuesArr[previousSlot] as ${ValueType}

        protected fun updateValue(newValue: ${ValueType}) {
            check(previousSlot != -1)
            if (keysArr !== this@${Name}HashMap.keysArr) throw ConcurrentModificationException()
            valuesArr[previousSlot] = newValue
        }

        fun remove() {
            check(previousSlot != -1)
            if (keysArr !== this@${Name}HashMap.keysArr) throw ConcurrentModificationException()

            removeSlot(previousSlot)
            previousSlot = -1
        }

        private fun decrement() {
            // see the similar function within HashSet for an explanation and discussion of why we stride by 17 here
            var s = slot
            do {
                s = (s - 17) and mask
            } while (keysArr[s] == ZERO)
            slot = s
        }
    }

    private inner class KeyIterator : Mutable${KeyType}Iterator() {
        private val it = SlotIterator()

        override fun hasNext(): Boolean = it.hasNext()
        override fun next${KeyType}(): ${KeyType} {
            it.nextSlot()
            return it.key()
        }
        override fun remove() = it.remove()
    }

<% if (!isReferenceValue) { %>
    private inner class ValueIterator : Mutable${ValueIteratorType}${Generics}() {
<% } else { %>
    private inner class ValueIterator : Mutable${ValueIteratorType}${Generics} {
<% } %>
        private val it = SlotIterator()

        override fun hasNext(): Boolean = it.hasNext()

<% if (!isReferenceValue) { %>
        override fun next${ValueType}(): ${ValueType} {
<% } else { %>
        override fun next(): ${ValueType} {
<% } %>
            it.nextSlot()
            return it.value()
        }

        override fun remove() = it.remove()
    }

    private inner class FastEntryIterator: SlotIterator(), MutableFastIterator<Mutable${Name}Map.MutableEntry${Generics}>, Mutable${Name}Map.MutableEntry${Generics} {

        override val key: ${KeyType} get() = key()
        override var value: ${ValueType}
            get() = value()
            set(value) {
                updateValue(value)
            }

        override fun next(): Mutable${Name}Map.MutableEntry${Generics} {
            nextSlot()
            return this
        }

        override fun equals(other: Any?): Boolean = other is Map.Entry<*, *> && other.key == key && other.value == value
        override fun hashCode(): Int = key.hashCode() xor value.hashCode()
        override fun toString(): String = "\$key=\$value"
    }

    // the slot at the end of slot iteration (exclusive), also the slot that stores the zero value
    @Suppress("NOTHING_TO_INLINE")
    private inline fun ${KeyType}Array.endSlot(): Int = size - 1

    // caching the mask in a member var can shave a little off get miss latency - at the cost of +4 bytes per instance
    @Suppress("NOTHING_TO_INLINE")
    private inline fun ${KeyType}Array.mask() = size - 2

    @Suppress("NOTHING_TO_INLINE")
    private inline fun Int.rotVal(): Int = countOneBits()

    @Suppress("NOTHING_TO_INLINE")
    private inline fun mixHash(hashcode: Int, rotVal: Int): Int {
        // see equivalent function in HashSet for explanation and commentary
        return (hashcode * K).rotateLeft(rotVal)
    }

    @Suppress("NOTHING_TO_INLINE")
    private inline fun ${KeyType}.slot(mask: Int, rotVal: Int): Int {
        return mixHash(this.hashCode(), rotVal) and mask
    }

    @Suppress("NOTHING_TO_INLINE")
    private inline fun Int.nextSlot(mask: Int): Int {
        return (this + 1) and mask
    }

    @Suppress("NOTHING_TO_INLINE")
    private inline fun ${KeyType}.slotDistance(slot: Int, mask: Int, rotVal: Int): Int {
        return (slot - slot(mask, rotVal)) and mask
    }

    private companion object {
        // the value of a field in an uninitialized primitive array
        @Suppress("REDUNDANT_CALL_OF_CONVERSION_METHOD")
        private const val ZERO: ${KeyType} = 0.to${KeyType}()
        @Suppress("REDUNDANT_CALL_OF_CONVERSION_METHOD")
        private const val NONZERO: ${KeyType} = 1.to${KeyType}()

        private val EMPTY_KEY_ARRAY = ${lowerKeyType}ArrayOf(ZERO, NONZERO)
<% if (!isReferenceValue) { %>
        private val EMPTY_VALUE_ARRAY = ${ValueType}Array(2)
<% } else { %>
        private val EMPTY_VALUE_ARRAY = arrayOfNulls<Any?>(2)
<% } %>

        // Constant taken from:
        //     "Computationally Easy, Spectrally Good Multipliers for Congruential
        //     Pseudorandom Number Generators" by Guy Steele and Sebastiano Vigna.
        private const val K: Int = 0x93d765dd.toInt()

        private const val DEFAULT_INITIAL_CAPACITY = 7
        private const val MAXIMUM_CAPACITY: Int = 1 shl 30 // must be power of two

        private const val CACHE_LINE_SIZE = 64 / ${KeyType}.SIZE_BYTES
        private const val HALF_CACHE_LINE_SIZE = CACHE_LINE_SIZE / 2
        // we force the load factor to 1.0 up to the size of two cache lines
        private const val FORCE_LOAD_FACTOR_MAX: Int = 2 * CACHE_LINE_SIZE
        // mask for # of elements in a single cache line
        private const val CACHE_LINE_MASK: Int = CACHE_LINE_SIZE - 1

        private fun arraySize(capacity: Int, loadFactor: Float): Int {
            check(capacity >= 0)
            // array must always maintain the invariant of at least one slot remaining open
            val requiredArraySize = max((capacity / loadFactor).toInt(), capacity + 1)
            // add extra slot to hold zero value at the end
            return minPowerOfTwo(requiredArraySize) + 1
        }

        private fun minPowerOfTwo(cap: Int): Int {
            val n = -1 ushr (cap - 1).countLeadingZeroBits()
            return if (n < 0) 1 else if (n >= MAXIMUM_CAPACITY) MAXIMUM_CAPACITY else n + 1
        }
    }
}
