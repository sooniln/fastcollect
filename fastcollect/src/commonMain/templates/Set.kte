/**
 * Methods for dealing with ${Type}Sets.
 */
@file:JvmName("${Type}Sets")

package io.github.sooniln.fastcollect

import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
import kotlin.jvm.JvmName
import kotlin.jvm.JvmSynthetic

public fun empty${Type}Set(): ${Type}Set = Empty${Type}Set

public fun ${lowerType}SetOf(): ${Type}Set = Empty${Type}Set
public fun ${lowerType}SetOf(element: ${Type}): ${Type}Set = Singleton${Type}Set(element)
public fun ${lowerType}SetOf(vararg elements: ${Type}): ${Type}Set = ${Type}HashSet(elements.as${Type}List())

public fun mutable${Type}SetOf(): Mutable${Type}Set = ${Type}HashSet()
public fun mutable${Type}SetOf(element: ${Type}): Mutable${Type}Set = ${Type}HashSet(1).apply { add(element) }
public fun mutable${Type}SetOf(vararg elements: ${Type}): Mutable${Type}Set = ${Type}HashSet(elements.as${Type}List())

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun build${Type}Set(expectedSize: Int = 0, builderAction: Mutable${Type}Set.() -> Unit): ${Type}Set {
    contract { callsInPlace(builderAction, InvocationKind.EXACTLY_ONCE) }
    val set = ${Type}HashSet(expectedSize)
    set.builderAction()
    return set
}

/**
 * A set of ${Type}s.
 */
public interface ${Type}Set : ${Type}Collection

public fun ${Type}Set.asSet(): Set<$Type> = ${Type}SetWrapper(this)

public infix fun ${Type}Set.union(other: ${Type}Set): ${Type}Set = ${Type}HashSet(this).apply { addAll(other) }

public infix fun ${Type}Set.intersect(other: ${Type}Set): ${Type}Set {
    if (other.size > size) return other.intersect(this)

    val set = ${Type}HashSet(other.size)
    other.traverse { element ->
        if (contains(element)) set.add(element)
    }
    return set
}

public infix fun ${Type}Set.subtract(other: ${Type}Set): ${Type}Set {
    val set = ${Type}HashSet(size)
    traverse { element ->
        if (!other.contains(element)) set.add(element)
    }
    return set
}

/**
 * A mutable set of ${Type}s.
 */
public interface Mutable${Type}Set : ${Type}Set, Mutable${Type}Collection

public abstract class Abstract${Type}Set : Abstract${Type}Collection(), ${Type}Set {
    override fun equals(other: Any?): Boolean {
        if (other === this) return true
        if (other is ${Type}Set) {
            if (size != other.size) return false
            return other.containsAll(this)
        }

        return false
    }

    override fun hashCode(): Int {
        var hashCode = 0
        traverse { element ->
            hashCode += element.hashCode()
        }
        return hashCode
    }
}

public abstract class AbstractMutable${Type}Set : Abstract${Type}Set(), Mutable${Type}Set

public fun Mutable${Type}Set.asSet(): MutableSet<$Type> = Mutable${Type}SetWrapper(this)

private object Empty${Type}Set : Abstract${Type}Set() {
    override val size: Int get() = 0

    override fun isEmpty(): Boolean = true
    override fun contains(element: ${Type}): Boolean = false
    override fun containsAll(elements: Collection<${Type}>): Boolean = elements.isEmpty()
    override fun containsAll(elements: ${Type}Collection): Boolean = elements.isEmpty()

    override fun iterator(): ${Type}Iterator = empty${Type}Iterator()
    override fun traverser(): ${Type}Traverser = empty${Type}Traverser()
}

private class Singleton${Type}Set(private val value: ${Type}) : Abstract${Type}Set() {
    override val size: Int get() = 1

    override fun isEmpty(): Boolean = false
    override fun contains(element: ${Type}): Boolean = value equalsRaw element

    override fun iterator(): ${Type}Iterator = object : ${Type}Iterator() {
        private var complete = false
        override fun hasNext(): Boolean = !complete
        override fun next${Type}(): ${Type} {
            if (complete) throw NoSuchElementException()
            complete = true
            return value
        }
    }

    override fun traverser(): ${Type}Traverser = object : ${Type}Traverser {
        private var complete = false
        override val value: ${Type} get() {
            check(complete)
            return this@Singleton${Type}Set.value
        }
        override fun forward(): Boolean {
            if (complete) return false
            complete = true
            return true
        }
    }
}

private class ${Type}SetWrapper(private val set: ${Type}Set) : AbstractSet<${Type}>() {
    override val size: Int get() = set.size
    override fun contains(element: ${Type}) = set.contains(element)
    override fun iterator() = set.iterator()
}

private class Mutable${Type}SetWrapper(private val set: Mutable${Type}Set) : AbstractMutableSet<${Type}>() {
    override val size: Int get() = set.size
    override fun contains(element: ${Type}) = set.contains(element)
    override fun containsAll(elements: Collection<${Type}>): Boolean = set.containsAll(elements)
    override fun iterator() = set.iterator()

    override fun add(element: ${Type}) = set.add(element)
    override fun remove(element: ${Type}): Boolean = set.remove(element)
    override fun clear() = set.clear()

    override fun addAll(elements: Collection<${Type}>): Boolean = set.addAll(elements)
    override fun removeAll(elements: Collection<${Type}>): Boolean = set.removeAll(elements)
    override fun retainAll(elements: Collection<${Type}>): Boolean = set.retainAll(elements)
}
