package io.github.sooniln.fastcollect.${subpackage}

import io.github.sooniln.fastcollect.${lowerNonFPType}s.${NonFPType}HashSet
import kotlin.jvm.JvmInline
import kotlin.math.max

public typealias ${Type}HashSet = Inline${Type}HashSet

@Suppress("OVERRIDE_BY_INLINE")
@JvmInline
public value class Inline${Type}HashSet internal constructor(@PublishedApi internal val set: ${NonFPType}HashSet) : Mutable${Type}Set {

    public constructor(capacity: Int = 0) : this(${NonFPType}HashSet(capacity))
    public constructor(elements: ${Type}Collection) : this() { addAll(elements) }
    public constructor(elements: Collection<${Type}>) : this() { addAll(elements) }

    override val size: Int
        inline get() = set.size

    public fun ensureCapacity(capacity: Int) { set.ensureCapacity(capacity) }
    public fun trimToSize() { set.trimToSize() }

    override fun contains(element: ${Type}): Boolean = set.contains(element.toBits())
    override fun add(element: ${Type}): Boolean = set.add(element.toBits())
    override fun remove(element: ${Type}): Boolean = set.remove(element.toBits())
    override fun clear() { set.clear() }

    override fun addAll(elements: ${Type}Collection): Boolean {
        if (elements is Inline${Type}HashSet) {
            return set.addAll(elements.set)
        } else {
            set.ensureCapacity(max(set.size + (elements.size / 2), elements.size))
            var modified = false
            for (element in elements) {
                modified = set.add(element.toBits()) or modified
            }
            return modified
        }
    }
    override fun addAll(elements: Collection<${Type}>): Boolean {
        if (elements is ${Type}Collection) {
            return addAll(elements)
        } else {
            set.ensureCapacity(max(set.size + (elements.size / 2), elements.size))
            var modified = false
            for (element in elements) {
                modified = set.add(element.toBits()) or modified
            }
            return modified
        }
    }

    override fun iterator(): InlineMutable${Type}Iterator = InlineMutable${Type}Iterator(set.iterator())

    override fun fastForEach(action: (${Type}) -> Unit) {
        set.fastForEach { element -> action(${Type}.fromBits(element)) }
    }
}
