package io.github.sooniln.fastcollect

import kotlin.jvm.JvmName
import kotlin.math.max

@Suppress("OVERRIDE_BY_INLINE")
public class ${Name}HashMap private constructor(@PublishedApi internal val map: ${NonFPName}HashMap) : AbstractMutable${Name}Map() {

    public constructor(
        capacity: Int = 0,
        /** The default value should be the value that is ideally least likely to occur in the map. */
        defaultValue: ${ValueType} = ${DefaultValue}
    ) : this(${NonFPName}HashMap(capacity, defaultValue.toBits()))
    public constructor(map: ${Name}Map${Generics}): this() { putAll(map) }
    public constructor(map: Map<${KeyType}, ${ValueType}>): this() { putAll(map) }

    override val size: Int
        inline get() = map.size

    override fun isDefaultValue(value: ${ValueType}): Boolean = map.isDefaultValue(value.toBits())

    public fun ensureCapacity(capacity: Int) { map.ensureCapacity(capacity) }
    public fun trimToSize() { map.trimToSize() }

    override fun containsKey(key: ${KeyType}): Boolean = map.containsKey(key)
    override fun containsValue(value: ${ValueType}): Boolean = map.containsValue(value.toBits())
    override fun get(key: ${KeyType}): ${ValueType} = ${ValueType}.fromBits(map[key])
    override fun getValue(key: ${KeyType}): ${ValueType} = ${ValueType}.fromBits(map.getValue(key))
    override fun getOrDefault(key: ${KeyType}, defaultValue: ${ValueType}): ${ValueType} = ${ValueType}.fromBits(map.getOrDefault(key, defaultValue.toBits()))
    override fun put(key: ${KeyType}, value: ${ValueType}): ${ValueType} = ${ValueType}.fromBits(map.put(key, value.toBits()))
    public fun putIfAbsent(key: ${KeyType}, value: ${ValueType}): ${ValueType} = ${ValueType}.fromBits(map.putIfAbsent(key, value.toBits()))
    override fun set(key: ${KeyType}, value: ${ValueType}) { map[key] = value.toBits() }
    override fun remove(key: ${KeyType}): ${ValueType} = ${ValueType}.fromBits(map.remove(key))
    override fun clear() { map.clear() }

    override fun putAll(from: ${Name}Map${Generics}) {
        if (from is ${Name}HashMap) {
            map.putAll(from.map)
        } else {
            ensureCapacity(max(size + (from.size / 2), from.size))
            super.putAll(from)
        }
    }
    override fun putAll(from: Map<out ${KeyType}, ${ValueType}>) {
        ensureCapacity(max(size + (from.size / 2), from.size))
        super.putAll(from)
    }

    override val keys: Mutable${KeyType}Set
        inline get() = map.keys
    override val values: Inline${ValueType}Collection
        @JvmName("getValues") inline get() = Inline${ValueType}Collection(map.values)

    override fun iterator(): MutableFastIterator<Mutable${Name}Map.MutableEntry> = EntryIterator(map.iterator())

    override fun foreach(action: ${KeyType}${ValueType}Consumer) {
        map.foreach { key, value -> action.accept(key, ${ValueType}.fromBits(value)) }
    }

    override fun foreachKey(action: ${KeyType}Consumer) {
        map.foreachKey(action)
    }

    override fun toString(): String = Iterable { iterator() }.joinToString(", ", "{", "}")

    private class EntryIterator(
        private val it: MutableFastIterator<Mutable${NonFPName}Map.MutableEntry>
    ) : MutableFastIterator<Mutable${Name}Map.MutableEntry>, Mutable${Name}Map.MutableEntry {

        private var entry: Mutable${NonFPName}Map.MutableEntry? = null

        override fun hasNext(): Boolean = it.hasNext()
        override fun next(): Mutable${Name}Map.MutableEntry {
            entry = it.next()
            return this
        }
        override fun remove() { it.remove() }

        override val key: ${KeyType}
            inline get() = entry!!.key
        override var value: ${ValueType}
            inline get() = ${ValueType}.fromBits(entry!!.value)
            inline set(value) { entry!!.value = value.toBits() }

        override fun equals(other: Any?): Boolean = other is ${Name}Map.Entry && other.key equalsBoxed key && other.value equalsBoxed value
        override fun hashCode(): Int = key.hashCode() xor value.hashCode()
        override fun toString(): String = "\$key=\$value"
    }
}
