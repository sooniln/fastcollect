/**
 * Methods for dealing with Traversables.
 */
@file:JvmName("Traversables")
@file:JvmMultifileClass

package io.github.sooniln.fastcollect

import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
import kotlin.experimental.ExperimentalTypeInference
import kotlin.jvm.JvmMultifileClass
import kotlin.jvm.JvmName
import kotlin.jvm.JvmSynthetic

public fun empty${Type}Traverser(): Mutable${Type}Traverser = Empty${Type}Traverser

/**
 * A primitively typed [Traversable] of ${Type}s.
 */
public interface ${Type}Traversable: Traversable<${Type}> {
    override fun traverser(): ${Type}Traverser
}

/**
 * A primitively typed [MutableTraversable] of ${Type}s.
 */
public interface Mutable${Type}Traversable: MutableTraversable<${Type}> {
    override fun traverser(): Mutable${Type}Traverser
}

/**
 * A primitively typed [Traverser] of ${Type}s.
 */
public interface ${Type}Traverser : Traverser<${Type}> {
    public val value: ${Type}

    /** DO NOT USE. May cause boxing. */
    @Deprecated(level = DeprecationLevel.HIDDEN, message = "May cause boxing.", replaceWith = ReplaceWith("value"))
    @get:JvmSynthetic
    override val element: ${Type} get() = value
}

/**
 * A primitively typed [MutableTraverser] of ${Type}s.
 */
public interface Mutable${Type}Traverser : ${Type}Traverser, MutableTraverser<${Type}>

@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Traversable.foreach(action: (${Type}) -> Unit) {
    contract { callsInPlace(action, InvocationKind.UNKNOWN) }

    val traverser = traverser()
    while (traverser.forward()) {
        action(traverser.value)
    }
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Traversable.any(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }

    foreach { if (predicate(it)) return true }
    return false
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Traversable.all(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return !any { !predicate(it) }
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Traversable.none(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return !any(predicate)
}

@OptIn(ExperimentalContracts::class)
public inline fun <R> ${Type}Traversable.fold(initial: R, operation: (accumulated: R, ${Type}) -> R): R {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }

    var accumulated = initial
    foreach { accumulated = operation(accumulated, it) }
    return accumulated
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Traversable.reduce(operation: (accumulated: ${Type}, ${Type}) -> ${Type}): ${Type} {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }

    val traverser = traverser()
    if (!traverser.forward()) throw NoSuchElementException()
    var accumulated = traverser.value
    while (traverser.forward()) {
        accumulated = operation(accumulated, traverser.value)
    }
    return accumulated
}

<% if (Type == "Byte" || Type == "Short" || Type == "Int") { %>
@Suppress("REDUNDANT_CALL_OF_CONVERSION_METHOD")
public fun ${Type}Traversable.sum(): Int = sumOf { it.toInt() }
<% } %>

@OptIn(ExperimentalContracts::class, ExperimentalTypeInference::class)
@OverloadResolutionByLambdaReturnType
public inline fun ${Type}Traversable.sumOf(selector: (${Type}) -> Int): Int {
    contract { callsInPlace(selector, InvocationKind.UNKNOWN) }

    var sum = 0
    foreach { sum += selector(it) }
    return sum
}

<% if (Type == "Long") { %>
public fun ${Type}Traversable.sum(): Long = sumOf { it }
<% } %>

@OptIn(ExperimentalContracts::class, ExperimentalTypeInference::class)
@OverloadResolutionByLambdaReturnType
public inline fun ${Type}Traversable.sumOf(selector: (${Type}) -> Long): Long {
    contract { callsInPlace(selector, InvocationKind.UNKNOWN) }

    var sum = 0L
    foreach { sum += selector(it) }
    return sum
}

<% if (Type == "Float" || Type == "Double") { %>
@Suppress("REDUNDANT_CALL_OF_CONVERSION_METHOD")
public fun ${Type}Traversable.sum(): Double = sumOf { it.toDouble() }
<% } %>

@OptIn(ExperimentalContracts::class, ExperimentalTypeInference::class)
@OverloadResolutionByLambdaReturnType
public inline fun ${Type}Traversable.sumOf(selector: (${Type}) -> Double): Double {
    contract { callsInPlace(selector, InvocationKind.UNKNOWN) }

    var sum = 0.0
    foreach { sum += selector(it) }
    return sum
}

private object Empty${Type}Traverser : Mutable${Type}Traverser {
    override fun forward(): Boolean = false
    override val value: ${Type} get() = throw IllegalStateException()
    override fun remove() = throw IllegalStateException()
}
