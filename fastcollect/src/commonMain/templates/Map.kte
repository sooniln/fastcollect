package io.github.sooniln.fastcollect.${keySubpackage}

import io.github.sooniln.fastcollect.assertBoxing
import io.github.sooniln.fastcollect.EntrySet
import io.github.sooniln.fastcollect.FastIterator
import io.github.sooniln.fastcollect.MutableEntrySet
import io.github.sooniln.fastcollect.emptyEntrySet
import io.github.sooniln.fastcollect.entrySetOf
import io.github.sooniln.fastcollect.${valueSubpackage}.${lowerValueType}ListOf
import io.github.sooniln.fastcollect.${valueSubpackage}.${ValueType}Collection
import io.github.sooniln.fastcollect.${valueSubpackage}.Mutable${ValueType}Collection
import io.github.sooniln.fastcollect.${valueSubpackage}.empty${ValueType}List
import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
import kotlin.experimental.ExperimentalTypeInference

public fun empty${KeyType}2${ValueType}Map(): ${KeyType}2${ValueType}Map = Empty${KeyType}2${ValueType}Map

public fun ${lowerKeyType}2${ValueType}MapOf(): ${KeyType}2${ValueType}Map = Empty${KeyType}2${ValueType}Map
public fun ${lowerKeyType}2${ValueType}MapOf(entry: Pair<${KeyType}, ${ValueType}>): ${KeyType}2${ValueType}Map = Singleton${KeyType}2${ValueType}Map(entry.first, entry.second)
public fun ${lowerKeyType}2${ValueType}MapOf(vararg entries: Pair<${KeyType}, ${ValueType}>): ${KeyType}2${ValueType}Map = ${KeyType}2${ValueType}HashMap(entries.size).apply { entries.forEach { set(it.first, it.second) } }

public fun mutable${KeyType}2${ValueType}MapOf(): Mutable${KeyType}2${ValueType}Map = ${KeyType}2${ValueType}HashMap()
public fun mutable${KeyType}2${ValueType}MapOf(entry: Pair<${KeyType}, ${ValueType}>): Mutable${KeyType}2${ValueType}Map = ${KeyType}2${ValueType}HashMap(1).apply { set(entry.first, entry.second) }
public fun mutable${KeyType}2${ValueType}MapOf(vararg entries: Pair<${KeyType}, ${ValueType}>): Mutable${KeyType}2${ValueType}Map = ${KeyType}2${ValueType}HashMap(entries.size).apply { entries.forEach { set(it.first, it.second) } }

@OptIn(ExperimentalContracts::class, ExperimentalTypeInference::class)
public inline fun build${KeyType}2${ValueType}Set(expectedSize: Int = 0, builderAction: Mutable${KeyType}2${ValueType}Map.() -> Unit): ${KeyType}2${ValueType}Map {
    contract { callsInPlace(builderAction, InvocationKind.EXACTLY_ONCE) }
    val map = ${KeyType}2${ValueType}HashMap(expectedSize)
    map.builderAction()
    return map
}

/**
 * A map of ${KeyType}s to ${ValueType}s which inherits from [Map].
 *
 * Because this interface is designed to store primitives, methods which lookup keys and return non-nullable primitive
 * values may not return null to indicate no such key is present. Instead, a ${KeyType}2${ValueType}Map has a
 * [defaultValue] which is returned instead to indicate no such key is present. Thus in order to obtain the best
 * performance implementations and clients are encouraged to ensure that the [defaultValue] is the value which is least
 * likely to ever appear in the possible set of values stored in this map. This is purely a performance and not a
 * correctness concern however - the map will still operate correctly and all methods will perform as expected even if
 * the map contains values equal to [defaultValue]. [Float.NaN] or [Double.NaN] are acceptable for [defaultValue] if
 * applicable.
 */
public interface ${KeyType}2${ValueType}Map : Map<${KeyType}, ${ValueType}> {
    public val defaultValue: ${ValueType}

    override fun isEmpty(): Boolean {
        return size == 0
    }

    override fun containsValue(value: ${ValueType}): Boolean {
        for (entry in primitiveEntries) {
            if (entry.value() == value) return true
        }
        return false
    }

    @Deprecated(
        message = "Use the lookup(key) method instead.",
        replaceWith = ReplaceWith("lookup(key)"),
        level = DeprecationLevel.WARNING)
    override fun get(key: ${KeyType}): ${ValueType}? {
        assertBoxing()
        val value = lookup(key)
        return if (isDefaultValue(value) && !containsKey(key)) null else value
    }

    public fun getOrDefault(key: ${KeyType}, defaultValue: ${ValueType}): ${ValueType} = getOrElse(key) { defaultValue }

    /**
     * Returns the value associated with the given key, or [defaultValue] if the given key is not present in the map.
     */
    public fun lookup(key: ${KeyType}): ${ValueType}

    override val keys: ${KeyType}Set

    override val values: ${ValueType}Collection

    @Deprecated(
        message = "Use primitiveEntries instead.",
        replaceWith = ReplaceWith("primitiveEntries"),
        level = DeprecationLevel.WARNING)
    override val entries: Set<Map.Entry<${KeyType}, ${ValueType}>>
        get() {
            assertBoxing()
            return primitiveEntries
        }

    public val primitiveEntries: EntrySet<Entry>

    public interface Entry : Map.Entry<${KeyType}, ${ValueType}> {
        @Deprecated(
            message = "Use key() instead.",
            replaceWith = ReplaceWith("key()"),
            level = DeprecationLevel.WARNING)
        override val key: ${KeyType} get() {
            assertBoxing()
            return key()
        }

        @Deprecated(
            message = "Use value() instead.",
            replaceWith = ReplaceWith("key()"),
            level = DeprecationLevel.WARNING)
        override val value: ${ValueType} get() {
            assertBoxing()
            return value()
        }

        public fun key(): ${KeyType}
        public fun value(): ${ValueType}
    }

    public operator fun iterator(): Iterator<${KeyType}2${ValueType}Map.Entry> = primitiveEntries.iterator()

    public fun fastIterator(): FastIterator<${KeyType}2${ValueType}Map.Entry> = primitiveEntries.fastIterator()
}


// handles presence of NaN correctly
@Suppress("NOTHING_TO_INLINE")
public inline fun ${KeyType}2${ValueType}Map.isDefaultValue(value: ${ValueType}): Boolean = value == defaultValue || (defaultValue != defaultValue && value != value)

@Suppress("NOTHING_TO_INLINE")
public inline fun ${KeyType}2${ValueType}Map.getValue(key: ${KeyType}): ${ValueType} = getOrElse(key) { throw NoSuchElementException() }

@OptIn(ExperimentalContracts::class)
public inline fun ${KeyType}2${ValueType}Map.getOrElse(key: ${KeyType}, defaultValue: () -> ${ValueType}): ${ValueType} {
    contract {
        callsInPlace(defaultValue, InvocationKind.AT_MOST_ONCE)
    }

    val value = lookup(key)
    return if (isDefaultValue(value) && !containsKey(key)) defaultValue() else value
}

@OptIn(ExperimentalContracts::class)
public inline fun ${KeyType}2${ValueType}Map.filterTo(destination: Mutable${KeyType}2${ValueType}Map, predicate: (key: ${KeyType}, value: ${ValueType}) -> Boolean): Mutable${KeyType}2${ValueType}Map {
    contract {
        callsInPlace(predicate, InvocationKind.UNKNOWN)
    }

    for (entry in primitiveEntries.fastIterator()) {
        if (predicate(entry.key(), entry.value())) {
            destination.putValue(entry.key(), entry.value())
        }
    }
    return destination
}

@OptIn(ExperimentalContracts::class)
public inline fun ${KeyType}2${ValueType}Map.filter(predicate: (key: ${KeyType}, value: ${ValueType}) -> Boolean): ${KeyType}2${ValueType}Map {
    contract {
        callsInPlace(predicate, InvocationKind.UNKNOWN)
    }

    return filterTo(${KeyType}2${ValueType}HashMap(), predicate)
}

/**
 * A mutable map of ${KeyType}s to ${ValueType}s which inherits from [MutableMap].
 */
public interface Mutable${KeyType}2${ValueType}Map : ${KeyType}2${ValueType}Map, MutableMap<${KeyType}, ${ValueType}> {

    @Deprecated(
        message = "Use putValue(key, value) instead.",
        replaceWith = ReplaceWith("putValue(key, value)"),
        level = DeprecationLevel.WARNING)
    override fun put(key: ${KeyType}, value: ${ValueType}): ${ValueType}? {
        assertBoxing()
        val value = putValue(key, value)
        return if (isDefaultValue(value) && !containsKey(key)) null else value
    }

    public fun putValue(key: ${KeyType}, value: ${ValueType}): ${ValueType}

    public operator fun set(key: ${KeyType}, value: ${ValueType}) {
        putValue(key, value)
    }

    @Deprecated(
        message = "Use removeKey(key) instead.",
        replaceWith = ReplaceWith("removeKey(key, value)"),
        level = DeprecationLevel.WARNING)
    override fun remove(key: ${KeyType}): ${ValueType}? {
        assertBoxing()
        return if (containsKey(key)) removeKey(key) else null
    }

    public fun removeKey(key: ${KeyType}): ${ValueType}

    public fun merge(key: ${KeyType}, value: ${ValueType}, merge: (oldValue: ${ValueType}, value: ${ValueType}) -> ${ValueType}): ${ValueType} {
        val oldValue = lookup(key)
        val newValue = if (isDefaultValue(oldValue) && !containsKey(key)) value else merge(oldValue, value)
        if (newValue != oldValue) {
            putValue(key, newValue)
        }
        return newValue
    }

    override val keys: Mutable${KeyType}Set
    override val values: Mutable${ValueType}Collection

    @Suppress("UNCHECKED_CAST")
    @Deprecated(
        message = "Use primitiveEntries instead.",
        replaceWith = ReplaceWith("primitiveEntries"),
        level = DeprecationLevel.WARNING)
    override val entries: MutableSet<MutableMap.MutableEntry<${KeyType}, ${ValueType}>>
        get() {
            assertBoxing()
            return primitiveEntries as MutableSet<MutableMap.MutableEntry<${KeyType}, ${ValueType}>>
        }

    override val primitiveEntries: MutableEntrySet<MutableEntry>

    public interface MutableEntry : ${KeyType}2${ValueType}Map.Entry, MutableMap.MutableEntry<${KeyType}, ${ValueType}>
}

@OptIn(ExperimentalContracts::class)
public inline fun Mutable${KeyType}2${ValueType}Map.getOrPut(key: ${KeyType}, defaultValue: () -> ${ValueType}): ${ValueType} {
    contract {
        callsInPlace(defaultValue, InvocationKind.AT_MOST_ONCE)
    }

    var value = lookup(key)
    if (isDefaultValue(value) && !containsKey(key)) {
        value = defaultValue()
        putValue(key, value)
    }
    return value
}

public abstract class Abstract${KeyType}2${ValueType}Map : ${KeyType}2${ValueType}Map {

    override fun equals(other: Any?): Boolean {
        if (other === this) return true
        if (other is Map<*, *>) {
            if (other.size != size) return false

            for (entry in fastIterator()) {
                if (other[entry.key()] != entry.value()) return false
            }

            return true
        }

        return false
    }

    override fun hashCode(): Int {
        var result = 0
        for (entry in fastIterator()) {
            result += entry.key().hashCode() xor entry.value().hashCode()
        }
        return result
    }

    override fun toString(): String {
        return Iterable { fastIterator() }.joinToString(", ", "{", "}") { "\${it.key()}=\${it.value()}" }
    }

    public class SimpleEntry(private val _key: ${KeyType}, private val _value: ${ValueType}) : ${KeyType}2${ValueType}Map.Entry {
        override fun key(): ${KeyType} = _key
        override fun value(): ${ValueType} = _value
    }
}

public abstract class AbstractMutable${KeyType}2${ValueType}Map : Abstract${KeyType}2${ValueType}Map(), Mutable${KeyType}2${ValueType}Map {

    public class SimpleMutableEntry(private val _key: ${KeyType}, private var _value: ${ValueType}) : Mutable${KeyType}2${ValueType}Map.MutableEntry {
        override fun key(): ${KeyType} = _key
        override fun value(): ${ValueType} = _value
        override fun setValue(newValue: ${ValueType}): ${ValueType} {
            val oldValue = _value
            _value = newValue
            return oldValue
        }
    }
}

private object Empty${KeyType}2${ValueType}Map : ${KeyType}2${ValueType}Map {
    override val defaultValue: ${ValueType} get() = ${DefaultValue}

    override val size: Int get() = 0
    override fun isEmpty(): Boolean = true

    override fun containsKey(key: ${KeyType}): Boolean = false
    override fun containsValue(value: ${ValueType}): Boolean = false
    override fun lookup(key: ${KeyType}): ${ValueType} = ${DefaultValue}

    override val keys: ${KeyType}Set get() = empty${KeyType}Set()
    override val values: ${ValueType}Collection get() = empty${ValueType}List()
    override val primitiveEntries: EntrySet<${KeyType}2${ValueType}Map.Entry> = emptyEntrySet()
}

private class Singleton${KeyType}2${ValueType}Map(private val key: ${KeyType}, private val value: ${ValueType}) : ${KeyType}2${ValueType}Map {
    override val defaultValue: ${ValueType} get() = ${DefaultValue}

    override val size: Int get() = 1
    override fun isEmpty(): Boolean = false

    override fun containsKey(key: ${KeyType}): Boolean = key == this.key
    override fun containsValue(value: ${ValueType}): Boolean = value == this.value
    override fun lookup(key: ${KeyType}): ${ValueType} = if (key == this.key) value else ${DefaultValue}

    override val keys: ${KeyType}Set by lazy { ${lowerKeyType}SetOf(key) }
    override val values: ${ValueType}Collection by lazy { ${lowerValueType}ListOf(value) }
    override val primitiveEntries: EntrySet<${KeyType}2${ValueType}Map.Entry> by lazy { entrySetOf(Abstract${KeyType}2${ValueType}Map.SimpleEntry(key, value)) }
}
