@file:Suppress("UnusedImport")

package io.github.sooniln.fastcollect.${keySubpackage}

import io.github.sooniln.fastcollect.assertBoxing
import io.github.sooniln.fastcollect.EntrySet
import io.github.sooniln.fastcollect.FastIterator
import io.github.sooniln.fastcollect.MutableEntrySet
import io.github.sooniln.fastcollect.emptyEntrySet
import io.github.sooniln.fastcollect.entrySetOf
<% if (!isReferenceValue) { %>
import io.github.sooniln.fastcollect.${valueSubpackage}.${lowerValueType}ListOf
import io.github.sooniln.fastcollect.${valueSubpackage}.${ValueType}Collection
import io.github.sooniln.fastcollect.${valueSubpackage}.Mutable${ValueType}Collection
import io.github.sooniln.fastcollect.${valueSubpackage}.empty${ValueType}List
<% } %>
import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
import kotlin.experimental.ExperimentalTypeInference

@Suppress("UNCHECKED_CAST")
public fun ${Generics} empty${Name}Map(): ${Name}Map${Generics} = Empty${Name}Map as ${Name}Map${Generics}

@Suppress("UNCHECKED_CAST")
public fun ${Generics} ${lowerName}MapOf(): ${Name}Map${Generics} = Empty${Name}Map as ${Name}Map${Generics}
public fun ${Generics} ${lowerName}MapOf(entry: Pair<${KeyType}, ${ValueType}>): ${Name}Map${Generics} = Singleton${Name}Map${Generics}(entry.first, entry.second)
public fun ${Generics} ${lowerName}MapOf(vararg entries: Pair<${KeyType}, ${ValueType}>): ${Name}Map${Generics} = ${Name}HashMap${Generics}(entries.size).apply { entries.forEach { set(it.first, it.second) } }

public fun ${Generics} mutable${Name}MapOf(): Mutable${Name}Map${Generics} = ${Name}HashMap()
public fun ${Generics} mutable${Name}MapOf(entry: Pair<${KeyType}, ${ValueType}>): Mutable${Name}Map${Generics} = ${Name}HashMap${Generics}(1).apply { set(entry.first, entry.second) }
public fun ${Generics} mutable${Name}MapOf(vararg entries: Pair<${KeyType}, ${ValueType}>): Mutable${Name}Map${Generics} = ${Name}HashMap${Generics}(entries.size).apply { entries.forEach { set(it.first, it.second) } }

@OptIn(ExperimentalContracts::class, ExperimentalTypeInference::class)
public inline fun ${Generics} build${Name}Map(expectedSize: Int = 0, builderAction: Mutable${Name}Map${Generics}.() -> Unit): ${Name}Map${Generics} {
    contract { callsInPlace(builderAction, InvocationKind.EXACTLY_ONCE) }

    val map = ${Name}HashMap${Generics}(expectedSize)
    map.builderAction()
    return map
}

/**
 * A map of ${KeyType}s to ${ValueType}s which inherits from [Map].
 *
<% if (!isReferenceValue) { %>
 * Because this interface is designed to store primitives, methods which lookup keys and return non-nullable primitive
 * values may not return null to indicate no such key is present. Instead, a ${Name}Map has a
 * [defaultValue] which is returned instead to indicate no such key is present. Thus in order to obtain the best
 * performance implementations and clients are encouraged to ensure that the [defaultValue] is the value which is least
 * likely to ever appear in the possible set of values stored in this map. This is purely a performance and not a
 * correctness concern however - the map will still operate correctly and all methods will perform as expected even if
 * the map contains values equal to [defaultValue]. [Float.NaN] or [Double.NaN] are acceptable for [defaultValue] if
 * applicable.
<% } %>
 */
public interface ${Name}Map${Generics} : Map<${KeyType}, ${ValueType}> {
<% if (!isReferenceValue) { %>
    public val defaultValue: ${ValueType}
<% } %>

    override fun isEmpty(): Boolean {
        return size == 0
    }

    override fun containsValue(value: ${ValueType}): Boolean {
        for (entry in primitiveEntries) {
            if (entry.value() == value) return true
        }
        return false
    }

<% if (!isReferenceValue) { %>
    @Deprecated(
        message = "Use the lookup(key) method instead.",
        replaceWith = ReplaceWith("lookup(key)"),
        level = DeprecationLevel.WARNING)
    override fun get(key: ${KeyType}): ${ValueType}? {
        assertBoxing()
        val value = lookup(key)
        return if (isDefaultValue(value) && !containsKey(key)) null else value
    }
<% } else { %>
    override fun get(key: ${KeyType}): ${ValueType}? = lookup(key)
<% } %>

    public fun getOrDefault(key: ${KeyType}, defaultValue: ${ValueType}): ${ValueType} = getOrElse(key) { defaultValue }

<% if (!isReferenceValue) { %>
    /**
     * Returns the value associated with the given key, or [defaultValue] if the given key is not present in the map.
     */
<% } else { %>
    /**
     * Returns the value associated with the given key, or null if the given key is not present in the map.
     */
<% } %>
    public fun lookup(key: ${KeyType}): ${ValueType}${Nullable}

    override val keys: ${KeyType}Set

    override val values: ${ValueCollectionType}${Generics}

    @Deprecated(
        message = "Use primitiveEntries instead.",
        replaceWith = ReplaceWith("primitiveEntries"),
        level = DeprecationLevel.WARNING)
    override val entries: Set<Map.Entry<${KeyType}, ${ValueType}>>
        get() {
            assertBoxing()
            return primitiveEntries
        }

    public val primitiveEntries: EntrySet<Entry${Generics}>

    public interface Entry${Generics} : Map.Entry<${KeyType}, ${ValueType}> {
        @Deprecated(
            message = "Use key() instead.",
            replaceWith = ReplaceWith("key()"),
            level = DeprecationLevel.WARNING)
        override val key: ${KeyType} get() {
            assertBoxing()
            return key()
        }

        @Deprecated(
            message = "Use value() instead.",
            replaceWith = ReplaceWith("key()"),
            level = DeprecationLevel.WARNING)
        override val value: ${ValueType} get() {
            assertBoxing()
            return value()
        }

        public fun key(): ${KeyType}
        public fun value(): ${ValueType}
    }

    public operator fun iterator(): Iterator<Entry${Generics}> = primitiveEntries.iterator()

    public fun fastIterator(): FastIterator<Entry${Generics}> = primitiveEntries.fastIterator()
}

<% if (!isReferenceValue) { %>
// handles presence of NaN correctly
@Suppress("NOTHING_TO_INLINE")
public inline fun ${Generics} ${Name}Map${Generics}.isDefaultValue(value: ${ValueType}): Boolean = value == defaultValue || (defaultValue != defaultValue && value != value)

@Suppress("NOTHING_TO_INLINE")
public inline fun ${Generics} ${Name}Map${Generics}.getValue(key: ${KeyType}): ${ValueType} = getOrElse(key) { throw NoSuchElementException() }

@OptIn(ExperimentalContracts::class)
public inline fun ${Generics} ${Name}Map${Generics}.getOrElse(key: ${KeyType}, defaultValue: () -> ${ValueType}): ${ValueType} {
    contract { callsInPlace(defaultValue, InvocationKind.AT_MOST_ONCE) }

    val value = lookup(key)
    return if (isDefaultValue(value) && !containsKey(key)) defaultValue() else value
}
<% } %>

/**
 * A mutable map of ${KeyType}s to ${ValueType}s which inherits from [MutableMap].
 */
public interface Mutable${Name}Map${Generics} : ${Name}Map${Generics}, MutableMap<${KeyType}, ${ValueType}> {

<% if (!isReferenceValue) { %>
    @Deprecated(
        message = "Use putValue(key, value) instead.",
        replaceWith = ReplaceWith("putValue(key, value)"),
        level = DeprecationLevel.WARNING)
    override fun put(key: ${KeyType}, value: ${ValueType}): ${ValueType}? {
        assertBoxing()
        val value = putValue(key, value)
        return if (isDefaultValue(value) && !containsKey(key)) null else value
    }
<% } else { %>
    override fun put(key: ${KeyType}, value: ${ValueType}): ${ValueType}? = putValue(key, value)
<% } %>

<% if (!isReferenceValue) { %>
    /**
     * Updates the value associated with the given key and returns the previous value, or [defaultValue] if the given
     * key was not present previously.
     */
<% } else { %>
    /**
     * Updates the value associated with the given key and returns the previous value, or null if the given key was not
     * present previously.
     */
<% } %>
    public fun putValue(key: ${KeyType}, value: ${ValueType}): ${ValueType}${Nullable}

    public operator fun set(key: ${KeyType}, value: ${ValueType}) {
        putValue(key, value)
    }

<% if (!isReferenceValue) { %>
    @Deprecated(
        message = "Use removeKey(key) instead.",
        replaceWith = ReplaceWith("removeKey(key, value)"),
        level = DeprecationLevel.WARNING)
    override fun remove(key: ${KeyType}): ${ValueType}? {
        assertBoxing()
        return if (containsKey(key)) removeKey(key) else null
    }
<% } else { %>
    override fun remove(key: ${KeyType}): ${ValueType}? = removeKey(key)
<% } %>

    public fun removeKey(key: ${KeyType}): ${ValueType}${Nullable}

<% if (!isReferenceValue) { %>
    public fun merge(key: ${KeyType}, value: ${ValueType}, merge: (oldValue: ${ValueType}, value: ${ValueType}) -> ${ValueType}): ${ValueType} {
        val oldValue = lookup(key)
        val newValue = if (isDefaultValue(oldValue) && !containsKey(key)) value else merge(oldValue, value)
        if (newValue != oldValue) {
            putValue(key, newValue)
        }
        return newValue
    }
<% } %>

    override val keys: Mutable${KeyType}Set
    override val values: Mutable${ValueCollectionType}${Generics}

    @Suppress("UNCHECKED_CAST")
    @Deprecated(
        message = "Use primitiveEntries instead.",
        replaceWith = ReplaceWith("primitiveEntries"),
        level = DeprecationLevel.WARNING)
    override val entries: MutableSet<MutableMap.MutableEntry<${KeyType}, ${ValueType}>>
        get() {
            assertBoxing()
            return primitiveEntries as MutableSet<MutableMap.MutableEntry<${KeyType}, ${ValueType}>>
        }

    override val primitiveEntries: MutableEntrySet<MutableEntry${Generics}>

    public interface MutableEntry${Generics} : ${Name}Map.Entry${Generics}, MutableMap.MutableEntry<${KeyType}, ${ValueType}>
}

<% if (!isReferenceValue) { %>
@OptIn(ExperimentalContracts::class)
public inline fun ${Generics} Mutable${Name}Map${Generics}.getOrPut(key: ${KeyType}, defaultValue: () -> ${ValueType}): ${ValueType} {
    contract { callsInPlace(defaultValue, InvocationKind.AT_MOST_ONCE) }

    var value = lookup(key)
    if (isDefaultValue(value) && !containsKey(key)) {
        value = defaultValue()
        putValue(key, value)
    }
    return value
}
<% } %>

public abstract class Abstract${Name}Map${Generics} : ${Name}Map${Generics} {

    override fun equals(other: Any?): Boolean {
        if (other === this) return true
        if (other is Map<*, *>) {
            if (other.size != size) return false

            for (entry in fastIterator()) {
                if (other[entry.key()] != entry.value()) return false
            }

            return true
        }

        return false
    }

    override fun hashCode(): Int {
        var result = 0
        for (entry in fastIterator()) {
            result += entry.key().hashCode() xor entry.value().hashCode()
        }
        return result
    }

    override fun toString(): String {
        return Iterable { fastIterator() }.joinToString(", ", "{", "}") { "\${it.key()}=\${it.value()}" }
    }

    public class SimpleEntry${Generics}(private val _key: ${KeyType}, private val _value: ${ValueType}) : ${Name}Map.Entry${Generics} {
        override fun key(): ${KeyType} = _key
        override fun value(): ${ValueType} = _value
    }
}

public abstract class AbstractMutable${Name}Map${Generics} : Abstract${Name}Map${Generics}(), Mutable${Name}Map${Generics} {

    public class SimpleMutableEntry${Generics}(private val _key: ${KeyType}, private var _value: ${ValueType}) : Mutable${Name}Map.MutableEntry${Generics} {
        override fun key(): ${KeyType} = _key
        override fun value(): ${ValueType} = _value
        override fun setValue(newValue: ${ValueType}): ${ValueType} {
            val oldValue = _value
            _value = newValue
            return oldValue
        }
    }
}

<% if (!isReferenceValue) { %>
private object Empty${Name}Map : ${Name}Map${Generics} {
<% } else { %>
private object Empty${Name}Map : ${Name}Map<Nothing> {
<% } %>

<% if (!isReferenceValue) { %>
    override val defaultValue: ${ValueType} get() = ${DefaultValue}
<% } %>

    override val size: Int get() = 0
    override fun isEmpty(): Boolean = true

    override fun containsKey(key: ${KeyType}): Boolean = false
<% if (!isReferenceValue) { %>
    override fun containsValue(value: ${ValueType}): Boolean = false
    override fun lookup(key: ${KeyType}): ${ValueType}${Nullable} = ${DefaultValue}
<% } else { %>
    override fun containsValue(value: Nothing): Boolean = false
    override fun lookup(key: ${KeyType}): Nothing${Nullable} = ${DefaultValue}
<% } %>


    override val keys: ${KeyType}Set get() = empty${KeyType}Set()
<% if (!isReferenceValue) { %>
    override val values: ${ValueCollectionType}${Generics} get() = empty${ValueType}List()
    override val primitiveEntries: EntrySet<${Name}Map.Entry${Generics}> = emptyEntrySet()
<% } else { %>
    override val values: ${ValueCollectionType}<Nothing> get() = emptyList()
    override val primitiveEntries: EntrySet<${Name}Map.Entry<Nothing>> = emptyEntrySet()
<% } %>
}

private class Singleton${Name}Map${Generics}(private val key: ${KeyType}, private val value: ${ValueType}) : ${Name}Map${Generics} {
<% if (!isReferenceValue) { %>
    override val defaultValue: ${ValueType} get() = ${DefaultValue}
<% } %>

    override val size: Int get() = 1
    override fun isEmpty(): Boolean = false

    override fun containsKey(key: ${KeyType}): Boolean = key == this.key
    override fun containsValue(value: ${ValueType}): Boolean = value == this.value
    override fun lookup(key: ${KeyType}): ${ValueType}${Nullable} = if (key == this.key) value else ${DefaultValue}

    override val keys: ${KeyType}Set by lazy { ${lowerKeyType}SetOf(key) }

<% if (!isReferenceValue) { %>
    override val values: ${ValueCollectionType}${Generics} by lazy { ${lowerValueType}ListOf(value) }
<% } else { %>
    override val values: ${ValueCollectionType}${Generics} by lazy { listOf(value) }
<% } %>

    override val primitiveEntries: EntrySet<${Name}Map.Entry${Generics}> by lazy { entrySetOf(Abstract${Name}Map.SimpleEntry(key, value)) }
}
