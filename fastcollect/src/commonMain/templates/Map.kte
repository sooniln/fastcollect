@file:Suppress("UnusedImport")

package io.github.sooniln.fastcollect.${keySubpackage}

import io.github.sooniln.fastcollect.FastIterator
import io.github.sooniln.fastcollect.MutableFastIterator
import io.github.sooniln.fastcollect.emptyFastIterator
<% if (!isReferenceValue) { %>
import io.github.sooniln.fastcollect.${valueSubpackage}.${lowerValueType}ListOf
import io.github.sooniln.fastcollect.${valueSubpackage}.${ValueType}Collection
import io.github.sooniln.fastcollect.${valueSubpackage}.Mutable${ValueType}Collection
import io.github.sooniln.fastcollect.${valueSubpackage}.empty${ValueType}List
<% } %>
import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
import kotlin.experimental.ExperimentalTypeInference

@Suppress("UNCHECKED_CAST")
public fun ${Generics} empty${Name}Map(): ${Name}Map${Generics} = Empty${Name}Map as ${Name}Map${Generics}

@Suppress("UNCHECKED_CAST")
public fun ${Generics} ${lowerName}MapOf(): ${Name}Map${Generics} = Empty${Name}Map as ${Name}Map${Generics}
public fun ${Generics} ${lowerName}MapOf(entry: Pair<${KeyType}, ${ValueType}>): ${Name}Map${Generics} = Singleton${Name}Map${Generics}(entry.first, entry.second)
public fun ${Generics} ${lowerName}MapOf(vararg entries: Pair<${KeyType}, ${ValueType}>): ${Name}Map${Generics} = ${Name}HashMap${Generics}(entries.size).apply { entries.forEach { set(it.first, it.second) } }

public fun ${Generics} mutable${Name}MapOf(): Mutable${Name}Map${Generics} = ${Name}HashMap()
public fun ${Generics} mutable${Name}MapOf(entry: Pair<${KeyType}, ${ValueType}>): Mutable${Name}Map${Generics} = ${Name}HashMap${Generics}(1).apply { set(entry.first, entry.second) }
public fun ${Generics} mutable${Name}MapOf(vararg entries: Pair<${KeyType}, ${ValueType}>): Mutable${Name}Map${Generics} = ${Name}HashMap${Generics}(entries.size).apply { entries.forEach { set(it.first, it.second) } }

@OptIn(ExperimentalContracts::class, ExperimentalTypeInference::class)
public inline fun ${Generics} build${Name}Map(expectedSize: Int = 0, builderAction: Mutable${Name}Map${Generics}.() -> Unit): ${Name}Map${Generics} {
    contract { callsInPlace(builderAction, InvocationKind.EXACTLY_ONCE) }

    val map = ${Name}HashMap${Generics}(expectedSize)
    map.builderAction()
    return map
}

/**
 * A map of ${KeyType}s to ${ValueType}s.
 *
<% if (!isReferenceValue) { %>
 * Because this interface is designed to store primitives, methods which lookup keys and return non-nullable primitive
 * values may not return null to indicate no such key is present. Instead, a ${Name}Map has a [defaultValue] which is
 * returned to indicate no such key is present. In order to obtain the best performance, implementations and clients are
 * encouraged to ensure that the [defaultValue] is the value which is least likely to ever appear in the possible set of
 * values stored in this map. This is purely a performance and not a correctness concern however - the map will still
 * operate correctly and all methods will perform as expected even if the map contains values equal to [defaultValue].
 * [Float.NaN] or [Double.NaN] are acceptable for [defaultValue] if applicable.
<% } %>
 */
public interface ${Name}Map${Generics} {
<% if (!isReferenceValue) { %>
    public val defaultValue: ${ValueType}
<% } %>

    public val size: Int

    public fun isEmpty(): Boolean {
        return size == 0
    }

    public operator fun get(key: ${KeyType}): ${ValueType}${Nullable}

    public fun containsKey(key: ${KeyType}): Boolean {
        for (k in keys) {
            if (k == key) return true
        }
        return false
    }

    public fun containsValue(value: ${ValueType}): Boolean {
        for (v in values) {
            if (v == value) return true
        }
        return false
    }

    public val keys: ${KeyType}Set
    public val values: ${ValueCollectionType}${Generics}

    public interface Entry${Generics} {
        public val key: ${KeyType}
        public val value: ${ValueType}
    }

    /** Returns a [FastIterator] over the map entries. */
    public operator fun iterator(): FastIterator<Entry${Generics}>
}

<% if (!isReferenceValue) { %>
// handles presence of NaN correctly
@Suppress("NOTHING_TO_INLINE")
public inline fun ${Generics} ${Name}Map${Generics}.isDefaultValue(value: ${ValueType}): Boolean = value == defaultValue || (defaultValue != defaultValue && value != value)
<% } else { %>
@Suppress("NOTHING_TO_INLINE", "UnusedReceiverParameter")
@PublishedApi
internal inline fun ${Generics} ${Name}Map${Generics}.isDefaultValue(value: ${ValueType}?): Boolean = value == null
<% } %>

public fun ${Generics} ${Name}Map${Generics}.asMap(): Map<${KeyType}, ${ValueType}> = ${Name}MapWrapper(this)

@Suppress("NOTHING_TO_INLINE")
public inline fun ${Generics} ${Name}Map${Generics}.getOrDefault(key: ${KeyType}, defaultValue: ${ValueType}): ${ValueType} = getOrElse(key) { defaultValue }

@Suppress("NOTHING_TO_INLINE")
public inline fun ${Generics} ${Name}Map${Generics}.getValue(key: ${KeyType}): ${ValueType} = getOrElse(key) { throw NoSuchElementException() }

@OptIn(ExperimentalContracts::class)
public inline fun ${Generics} ${Name}Map${Generics}.getOrElse(key: ${KeyType}, defaultValue: () -> ${ValueType}): ${ValueType} {
    contract { callsInPlace(defaultValue, InvocationKind.AT_MOST_ONCE) }

    val value = get(key)
    @Suppress("UNCHECKED_CAST", "USELESS_CAST")
    return if (isDefaultValue(value) && !containsKey(key)) defaultValue() else value as ${ValueType}
}

/**
 * A mutable map of ${KeyType}s to ${ValueType}s.
 */
public interface Mutable${Name}Map${Generics} : ${Name}Map${Generics} {

    public fun put(key: ${KeyType}, value: ${ValueType}): ${ValueType}${Nullable}

    public operator fun set(key: ${KeyType}, value: ${ValueType}) {
        put(key, value)
    }

    public fun remove(key: ${KeyType}): ${ValueType}${Nullable}

    public fun clear()

    override val keys: Mutable${KeyType}Set
    override val values: Mutable${ValueCollectionType}${Generics}

    public fun putAll(from: ${Name}Map${Generics}) {
        for (entry in from) {
            put(entry.key, entry.value)
        }
    }

    public fun putAll(from: Map<out ${KeyType}, ${ValueType}>) {
        for (entry in from) {
            put(entry.key, entry.value)
        }
    }

    public interface MutableEntry${Generics} : ${Name}Map.Entry${Generics} {
        override var value: ${ValueType}
    }

    override fun iterator(): MutableFastIterator<MutableEntry${Generics}>
}

public fun ${Generics} Mutable${Name}Map${Generics}.asMutableMap(): MutableMap<${KeyType}, ${ValueType}> = Mutable${Name}MapWrapper(this)

@OptIn(ExperimentalContracts::class)
public inline fun ${Generics} Mutable${Name}Map${Generics}.merge(key: ${KeyType}, value: ${ValueType}, merge: (oldValue: ${ValueType}, value: ${ValueType}) -> ${ValueType}): ${ValueType} {
    contract { callsInPlace(merge, InvocationKind.AT_MOST_ONCE) }

    val oldValue = get(key)
    @Suppress("UNCHECKED_CAST", "USELESS_CAST")
    val newValue = if (isDefaultValue(oldValue) && !containsKey(key)) value else merge(oldValue as ${ValueType}, value)
    if (newValue != oldValue) {
        set(key, newValue)
    }
    return newValue
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Generics} Mutable${Name}Map${Generics}.getOrPut(key: ${KeyType}, defaultValue: () -> ${ValueType}): ${ValueType} {
    contract { callsInPlace(defaultValue, InvocationKind.AT_MOST_ONCE) }

    var value = get(key)
    if (isDefaultValue(value) && !containsKey(key)) {
        value = defaultValue()
        set(key, value)
        return value
    } else {
        @Suppress("UNCHECKED_CAST", "USELESS_CAST")
        return value as ${ValueType}
    }
}

public abstract class Abstract${Name}Map${Generics} : ${Name}Map${Generics} {

    override fun equals(other: Any?): Boolean {
        if (other === this) return true
        if (other is Map<*, *>) {
            if (other.size != size) return false

            for (entry in this) {
                if (other[entry.key] != entry.value) return false
            }

            return true
        }

        return false
    }

    override fun hashCode(): Int {
        var result = 0
        for (entry in this) {
            result += entry.key.hashCode() xor entry.value.hashCode()
        }
        return result
    }

    override fun toString(): String {
        return Iterable { iterator() }.joinToString(", ", "{", "}") { "\${it.key}=\${it.value}" }
    }

    public class SimpleEntry${Generics}(override val key: ${KeyType}, override val value: ${ValueType}) : ${Name}Map.Entry${Generics}
}

public abstract class AbstractMutable${Name}Map${Generics} : Abstract${Name}Map${Generics}(), Mutable${Name}Map${Generics}

<% if (!isReferenceValue) { %>
private object Empty${Name}Map : ${Name}Map${Generics} {
<% } else { %>
private object Empty${Name}Map : ${Name}Map<Nothing> {
<% } %>

<% if (!isReferenceValue) { %>
    override val defaultValue: ${ValueType} get() = ${DefaultValue}
<% } %>

    override val size: Int get() = 0
    override fun isEmpty(): Boolean = true

    override fun containsKey(key: ${KeyType}): Boolean = false
<% if (!isReferenceValue) { %>
    override fun containsValue(value: ${ValueType}): Boolean = false
    override fun get(key: ${KeyType}): ${ValueType}${Nullable} = ${DefaultValue}
<% } else { %>
    override fun containsValue(value: Nothing): Boolean = false
    override fun get(key: ${KeyType}): Nothing${Nullable} = ${DefaultValue}
<% } %>


    override val keys: ${KeyType}Set get() = empty${KeyType}Set()
<% if (!isReferenceValue) { %>
    override val values: ${ValueCollectionType}${Generics} get() = empty${ValueType}List()
    override fun iterator() = emptyFastIterator<${Name}Map.Entry>()
<% } else { %>
    override val values: ${ValueCollectionType}<Nothing> get() = emptyList()
    override fun iterator() = emptyFastIterator<${Name}Map.Entry<Nothing>>()
<% } %>
}

private class Singleton${Name}Map${Generics}(private val key: ${KeyType}, private val value: ${ValueType}) : ${Name}Map${Generics} {
<% if (!isReferenceValue) { %>
    override val defaultValue: ${ValueType} get() = ${DefaultValue}
<% } %>

    override val size: Int get() = 1
    override fun isEmpty(): Boolean = false

    override fun containsKey(key: ${KeyType}): Boolean = key == this.key
    override fun containsValue(value: ${ValueType}): Boolean = value == this.value
    override fun get(key: ${KeyType}): ${ValueType}${Nullable} = if (key == this.key) value else ${DefaultValue}

    override val keys: ${KeyType}Set by lazy { ${lowerKeyType}SetOf(key) }

<% if (!isReferenceValue) { %>
    override val values: ${ValueCollectionType}${Generics} by lazy { ${lowerValueType}ListOf(value) }
<% } else { %>
    override val values: ${ValueCollectionType}${Generics} by lazy { listOf(value) }
<% } %>

    override fun iterator() = object : FastIterator<${Name}Map.Entry${Generics}> {
        private var complete: Boolean = false

        override fun hasNext() = !complete
        override fun next(): ${Name}Map.Entry${Generics} {
            if (complete) throw NoSuchElementException()
            complete = true
            return Abstract${Name}Map.SimpleEntry(key, value)
        }
    }
}

private class ${Name}MapWrapper${Generics}(private val map: ${Name}Map${Generics}) : AbstractMap<${KeyType}, ${ValueType}>() {
    override val size: Int get() = map.size

    override fun get(key: ${KeyType}): ${ValueType}? {
        val value = map.get(key)
        return if (map.isDefaultValue(value) && !map.containsKey(key)) null else value
    }

    override fun containsKey(key: ${KeyType}): Boolean = map.containsKey(key)

    override fun containsValue(value: ${ValueType}): Boolean = map.containsValue(value)

    override val entries: Set<Map.Entry<${KeyType}, ${ValueType}>> = object : AbstractSet<Map.Entry<${KeyType}, ${ValueType}>>() {
        override val size: Int get() = map.size

        override fun contains(element: Map.Entry<${KeyType}, ${ValueType}>): Boolean {
            val value = map[element.key]
            if (map.isDefaultValue(value) && !containsKey(element.key)) return false
            return value == element.value
        }

        override fun iterator(): Iterator<Map.Entry<${KeyType}, ${ValueType}>> = object : Iterator<Map.Entry<${KeyType}, ${ValueType}>> {
            private val it = map.iterator()

            override fun hasNext(): Boolean = it.hasNext()
            override fun next(): Map.Entry<${KeyType}, ${ValueType}> {
                val entry = it.next()
                return object : Map.Entry<${KeyType}, ${ValueType}> {
                    override val key = entry.key
                    override val value = entry.value
                }
            }
        }
    }
}

private class Mutable${Name}MapWrapper${Generics}(private val map: Mutable${Name}Map${Generics}) : AbstractMutableMap<${KeyType}, ${ValueType}>() {
    override val size: Int get() = map.size

    override fun get(key: ${KeyType}): ${ValueType}? {
        val value = map.get(key)
        return if (map.isDefaultValue(value) && !map.containsKey(key)) null else value
    }

    override fun containsKey(key: ${KeyType}): Boolean = map.containsKey(key)

    override fun containsValue(value: ${ValueType}): Boolean = map.containsValue(value)

    override fun remove(key: ${KeyType}): ${ValueType}? {
        return if (map.containsKey(key)) map.remove(key) else null
    }

    override fun put(key: ${KeyType}, value: ${ValueType}): ${ValueType}? {
        val containsKey = map.containsKey(key)
        val oldValue = map.put(key, value)
        return if (containsKey) oldValue else null
    }

    override fun clear(): Unit = map.clear()

    override val entries: MutableSet<MutableMap.MutableEntry<${KeyType}, ${ValueType}>> = object : AbstractMutableSet<MutableMap.MutableEntry<${KeyType}, ${ValueType}>>() {
        override val size: Int get() = map.size

        override fun contains(element: MutableMap.MutableEntry<${KeyType}, ${ValueType}>): Boolean {
            val value = map[element.key]
            if (map.isDefaultValue(value) && !containsKey(element.key)) return false
            return value == element.value
        }

        override fun add(element: MutableMap.MutableEntry<${KeyType}, ${ValueType}>): Boolean = throw UnsupportedOperationException()

        override fun iterator(): MutableIterator<MutableMap.MutableEntry<${KeyType}, ${ValueType}>> = object : MutableIterator<MutableMap.MutableEntry<${KeyType}, ${ValueType}>> {
            private val it = map.iterator()

            override fun hasNext(): Boolean = it.hasNext()
            override fun next(): MutableMap.MutableEntry<${KeyType}, ${ValueType}> = it.next().let { e -> Entry(e.key, e.value) }
            override fun remove() = it.remove()
        }

        private inner class Entry(override val key: ${KeyType}, value: ${ValueType}) : MutableMap.MutableEntry<${KeyType}, ${ValueType}> {
            override var value = value
                private set

            override fun setValue(newValue: ${ValueType}): ${ValueType} {
                val oldValue = value
                if (map.put(key, newValue) != oldValue) throw ConcurrentModificationException()
                value = newValue
                return oldValue
            }

            override fun equals(other: Any?): Boolean = other is Map.Entry<*, *> && other.key == key && other.value == value
            override fun hashCode(): Int = key.hashCode() xor value.hashCode()
            override fun toString(): String = "\$key=\$value"
        }
    }
}
