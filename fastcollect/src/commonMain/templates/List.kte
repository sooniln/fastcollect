/**
 * Methods for dealing with ${Type}Lists.
 */
@file:JvmName("${Type}Lists")

package io.github.sooniln.fastcollect

import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
import kotlin.jvm.JvmName
import kotlin.jvm.JvmSynthetic
import kotlin.random.Random

public fun empty${Type}List(): ${Type}List = Empty${Type}List

public fun ${lowerType}ListOf(): ${Type}List = Empty${Type}List
public fun ${lowerType}ListOf(element: ${Type}): ${Type}List = Singleton${Type}List(element)
public fun ${lowerType}ListOf(vararg elements: ${Type}): ${Type}List = ${Type}ArrayDeque(elements)

public fun mutable${Type}ListOf(): Mutable${Type}List = ${Type}ArrayDeque()
public fun mutable${Type}ListOf(element: ${Type}): Mutable${Type}List = ${Type}ArrayDeque(1).apply { add(element) }
public fun mutable${Type}ListOf(vararg elements: ${Type}): Mutable${Type}List = ${Type}ArrayDeque(elements)

public fun ${Type}Array.as${Type}List(): ${Type}List = ${Type}ArrayListWrapper(this)

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun build${Type}List(expectedSize: Int = 0, builderAction: Mutable${Type}List.() -> Unit): ${Type}List {
    contract { callsInPlace(builderAction, InvocationKind.EXACTLY_ONCE) }

    val list = ${Type}ArrayDeque(expectedSize)
    list.builderAction()
    return list
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}List(size: Int, init: (index: Int) -> ${Type}): ${Type}List {
    contract { callsInPlace(init, InvocationKind.UNKNOWN) }
    return Mutable${Type}List(size, init)
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun Mutable${Type}List(size: Int, init: (index: Int) -> ${Type}): Mutable${Type}List {
    contract { callsInPlace(init, InvocationKind.UNKNOWN) }

    val list = ${Type}ArrayDeque(size)
    repeat(size) { index -> list.add(init(index)) }
    return list
}

public interface ${Type}ListTraversable: ${Type}Traversable {
    public fun traverser(position: Int): ${Type}ListTraverser
}

public interface Mutable${Type}ListTraversable: Mutable${Type}Traversable, ${Type}ListTraversable {
    override fun traverser(position: Int): Mutable${Type}ListTraverser
}

public interface ${Type}ListTraverser : ${Type}Traverser {
    public val position: Int
    public fun backward(): Boolean
}

public interface Mutable${Type}ListTraverser : ${Type}ListTraverser, Mutable${Type}Traverser {
    public fun set(value: ${Type})
    public fun insert(value: ${Type})
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}List.foreachReverse(action: (${Type}) -> Unit) {
    contract { callsInPlace(action, InvocationKind.UNKNOWN) }

    val traverser = traverser(size)
    while (traverser.backward()) {
        action(traverser.value)
    }
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}ListTraversable.foreachIndexed(action: (Int, ${Type}) -> Unit) {
    contract { callsInPlace(action, InvocationKind.UNKNOWN) }

    val traverser = traverser(0)
    var index = 0
    while (traverser.forward()) {
        action(index++, traverser.value)
    }
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}List.foreachReverseIndexed(action: (Int, ${Type}) -> Unit) {
    contract { callsInPlace(action, InvocationKind.UNKNOWN) }

    val traverser = traverser(size)
    var index = size
    while (traverser.backward()) {
        action(--index, traverser.value)
    }
}

/**
 * A list of ${Type}s.
 */
public interface ${Type}List : ${Type}Collection, ${Type}ListTraversable {

    override fun contains(element: ${Type}): Boolean {
        return indexOf(element) != -1
    }

    public operator fun get(index: Int): ${Type}

    public fun indexOf(element: ${Type}): Int {
        foreachIndexed { index, value ->
            if (value equalsRaw element) {
                return index
            }
        }
        return -1
    }

    public fun lastIndexOf(element: ${Type}): Int {
        foreachReverseIndexed { index, value ->
            if (value equalsRaw element) {
                return index
            }
        }
        return -1
    }

    public fun subList(fromIndex: Int, toIndex: Int): ${Type}List

    override fun copyInto(destination: ${Type}Array, destinationOffset: Int): ${Type}Array {
        return copyInto(destination, destinationOffset, 0, size)
    }

    /**
     * Copies the elements of this list in the range [[fromIndex], [toIndex]) into [destination], starting at
     * [destinationOffset], and returns [destination].
     */
    public fun copyInto(destination: ${Type}Array, destinationOffset: Int, fromIndex: Int, toIndex: Int): ${Type}Array {
        rangeCheck(fromIndex, toIndex)
        val destinationToIndex = destinationOffset + toIndex - fromIndex
        destination.rangeCheck(destinationOffset, destinationToIndex)

        val traverser = traverser(fromIndex)
        for (index in destinationOffset..<destinationToIndex) {
            check(traverser.forward())
            destination[index] = traverser.value
        }
        return destination
    }
}

public val ${Type}List.indices: IntRange @JvmSynthetic inline get() = 0..<size

public val ${Type}List.lastIndex: Int @JvmSynthetic inline get() = size - 1

@JvmSynthetic
public fun ${Type}List.first(): ${Type} = if (isEmpty()) throw NoSuchElementException() else this[0]

@JvmSynthetic
public fun ${Type}List.last(): ${Type} = if (isEmpty()) throw NoSuchElementException() else this[lastIndex]

@JvmSynthetic
public fun ${Type}List.copyInto(destination: ${Type}Array, destinationOffset: Int = 0, fromIndex: Int = 0, toIndex: Int = destination.size): ${Type}Array {
    return copyInto(destination, destinationOffset, fromIndex, toIndex)
}

public fun ${Type}List.indexCheck(index: Int): Int {
    if (index !in 0..<size) throw IndexOutOfBoundsException("index=\$index, size=\$size")
    return index
}

public fun ${Type}List.indexCheckInclusive(index: Int): Int {
    if (index !in 0..size) throw IndexOutOfBoundsException("index=\$index, size=\$size")
    return index
}

public fun ${Type}List.rangeCheck(fromIndex: Int, toIndex: Int) {
    require(fromIndex <= toIndex)
    if (fromIndex < 0) throw IndexOutOfBoundsException("fromIndex=\$fromIndex")
    if (toIndex > size) throw IndexOutOfBoundsException("toIndex=\$toIndex, size=\$size")
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun <R> ${Type}List.foldRight(initial: R, operation: (${Type}, accumulated: R) -> R): R {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }

    var accumulated = initial
    foreachReverse { value ->
        accumulated = operation(value, accumulated)
    }
    return accumulated
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}List.reduceRight(operation: (${Type}, accumulated: ${Type}) -> ${Type}) : ${Type} {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }

    val traverser = traverser(size)
    if (!traverser.backward()) throw NoSuchElementException()
    var accumulated = traverser.value
    while (traverser.backward()) {
        accumulated = operation(traverser.value, accumulated)
    }
    return accumulated
}

public fun ${Type}List.asList(): List<$Type> = ${Type}ListWrapper(this)

/**
 * A mutable list of ${Type}s.
 */
public interface Mutable${Type}List : ${Type}List, Mutable${Type}Collection, Mutable${Type}ListTraversable {

    override fun traverser(position: Int): Mutable${Type}ListTraverser

    public operator fun set(index: Int, element: ${Type})

    public fun replace(index: Int, element: ${Type}): ${Type} {
        val t = get(index)
        set(index, element)
        return t
    }

    override fun add(element: ${Type}): Boolean {
        addLast(element)
        return true
    }

    public fun add(index: Int, element: ${Type})

    public fun addFirst(element: ${Type}): Unit = add(0, element)
    public fun addLast(element: ${Type}): Unit = add(size, element)
    public fun removeFirst(): ${Type} = if (isEmpty()) throw NoSuchElementException() else removeAt(0)
    public fun removeLast(): ${Type} = if (isEmpty()) throw NoSuchElementException() else removeAt(lastIndex)

    override fun remove(element: ${Type}): Boolean {
        val index = indexOf(element)
        if (index == -1) {
            return false
        } else {
            removeAt(index)
            return true
        }
    }

    public fun removeAt(index: Int): ${Type}

    public fun removeRange(fromIndex: Int, toIndex: Int)

    override fun clear(): Unit = removeRange(0, size)

    override fun addAll(elements: ${Type}Collection): Boolean {
        elements.foreach { element ->
            addLast(element)
        }
        return !elements.isEmpty()
    }

    override fun addAll(elements: Collection<${Type}>): Boolean {
        for (element in elements) {
            addLast(element)
        }
        return !elements.isEmpty()
    }

    public fun addAll(index: Int, elements: ${Type}Collection) {
        var i = indexCheckInclusive(index)
        elements.foreach { element ->
            add(i++, element)
        }
    }

    public fun addAll(index: Int, elements: Collection<${Type}>) {
        var i = indexCheckInclusive(index)
        for (element in elements) {
            add(i++, element)
        }
    }

    public fun sort() {
        val sorted = copyInto(${Type}Array(size)).also { it.sort() }
        if (this is RandomAccess) {
            for (index in 0..<sorted.size) {
                set(index, sorted[index])
            }
        } else {
            val traverser = traverser(0)
            for (element in sorted) {
                check(traverser.forward())
                traverser.set(element)
            }
        }
    }

    public fun sortDescending() {
        val sorted = copyInto(${Type}Array(size)).also { it.sortDescending() }
        if (this is RandomAccess) {
            for (index in 0..<sorted.size) {
                set(index, sorted[index])
            }
        } else {
            val traverser = traverser(0)
            for (element in sorted) {
                check(traverser.forward())
                traverser.set(element)
            }
        }
    }

    public fun fill(element: ${Type}) {
        if (this is RandomAccess) {
            for (index in 0..<size) {
                set(index, element)
            }
        } else {
            val traverser = traverser(0)
            while (traverser.forward()) {
                traverser.set(element)
            }
        }
    }

    public fun shuffle(random: Random) {
        for (i in lastIndex downTo 1) {
            val j = random.nextInt(i + 1)
            val tmp = get(i)
            set(i, get(j))
            set(j, tmp)
        }
    }

    public fun reverse() {
        val midPoint = (size / 2)
        var j = size - 1
        for (i in 0..<midPoint) {
            val tmp = get(i)
            set(i, get(j))
            set(j, tmp)
            --j
        }
    }

    override fun subList(fromIndex: Int, toIndex: Int): Mutable${Type}List
}

public fun Mutable${Type}List.shuffle() { shuffle(Random) }

public fun Mutable${Type}List.asList(): MutableList<$Type> = Mutable${Type}ListWrapper(this)

public abstract class Abstract${Type}List : Abstract${Type}Collection(), ${Type}List {

    override fun iterator(): ${Type}Iterator = IteratorImpl()
    override fun traverser(): ${Type}Traverser = TraverserImpl()
    override fun traverser(position: Int): ${Type}ListTraverser = ListTraverserImpl(position)

    override fun subList(fromIndex: Int, toIndex: Int): ${Type}List {
        return if (this is RandomAccess) {
            RandomAccess${Type}SubList(this, fromIndex, toIndex)
        } else {
            ${Type}SubList(this, fromIndex, toIndex)
        }
    }

    override fun equals(other: Any?): Boolean {
        if (other === this) return true
        if (other !is ${Type}List) return false
        if (size != other.size) return false

        val traverser = traverser()
        val otherTraverser = other.traverser()

        var hasNext = traverser.forward()
        var otherHasNext = otherTraverser.forward()
        while (hasNext && otherHasNext) {
            if (!(traverser.value equalsRaw otherTraverser.value)) {
                return false
            }
            hasNext = traverser.forward()
            otherHasNext = otherTraverser.forward()
        }
        return !hasNext && !otherHasNext
    }

    override fun hashCode(): Int {
        var hashCode = 1
        foreach { element ->
            hashCode = 31 * hashCode + element.hashCode()
        }
        return hashCode
    }

    private inner class IteratorImpl: ${Type}Iterator() {
        private val size = this@Abstract${Type}List.size
        private var index = 0

        override fun hasNext(): Boolean = index < size
        override fun next${Type}(): ${Type} {
            if (index >= size) throw NoSuchElementException()
            if (size != this@Abstract${Type}List.size) throw ConcurrentModificationException()
            return get(index++)
        }
    }

    private inner class TraverserImpl : ${Type}Traverser {
        private val last = size - 1
        private var index = -1

        override val value: ${Type} get() {
            check(index >= 0)
            return get(index)
        }

        override fun forward(): Boolean {
            if (index >= last) return false
            if (last != size - 1) throw ConcurrentModificationException()
            ++index
            return true
        }
    }

    private inner class ListTraverserImpl(position: Int) : ${Type}ListTraverser {
        init {
            indexCheckInclusive(position)
        }

        private val size = this@Abstract${Type}List.size
        private var index = position - 1

        override var position: Int = position
            private set
        override val value: ${Type} get() {
            check(index >= 0)
            return get(index)
        }

        override fun forward(): Boolean {
            if (position >= size) return false
            if (size != this@Abstract${Type}List.size) throw ConcurrentModificationException()
            index = position++
            return true
        }

        override fun backward(): Boolean {
            if (position <= 0) return false
            if (size != this@Abstract${Type}List.size) throw ConcurrentModificationException()
            index = --position
            return true
        }
    }

    private open class ${Type}SubList(private val list: ${Type}List, fromIndex: Int, toIndex: Int) : Abstract${Type}List() {

        init {
            list.rangeCheck(fromIndex, toIndex)
        }

        private val offset = fromIndex
        final override var size = toIndex - fromIndex
            protected set

        override fun get(index: Int): ${Type} {
            indexCheck(index)
            return list[index + offset]
        }

        override fun copyInto(destination: ${Type}Array, destinationOffset: Int, fromIndex: Int, toIndex: Int): ${Type}Array {
            rangeCheck(fromIndex, toIndex)
            return list.copyInto(destination, destinationOffset, fromIndex + offset, toIndex + offset)
        }
    }

    private class RandomAccess${Type}SubList(list: ${Type}List, fromIndex: Int, toIndex: Int) : ${Type}SubList(list, fromIndex, toIndex), RandomAccess
}

public abstract class AbstractMutable${Type}List : Abstract${Type}List(), Mutable${Type}List {

    override fun iterator(): Mutable${Type}Iterator = IteratorImpl()
    override fun traverser(): Mutable${Type}Traverser = ListTraverserImpl(0)
    override fun traverser(position: Int): Mutable${Type}ListTraverser = ListTraverserImpl(position)

    override fun removeRange(fromIndex: Int, toIndex: Int) {
        rangeCheck(fromIndex, toIndex)

        val traverser = traverser(toIndex)
        repeat(toIndex-fromIndex) { _ ->
            check(traverser.backward())
            traverser.remove()
        }
    }

    override fun subList(fromIndex: Int, toIndex: Int): Mutable${Type}List {
        return if (this is RandomAccess) {
            RandomAccess${Type}SubList(this, fromIndex, toIndex)
        } else {
            ${Type}SubList(this, fromIndex, toIndex)
        }
    }

    private inner class IteratorImpl: Mutable${Type}Iterator() {
        private var size = this@AbstractMutable${Type}List.size
        private var index = 0
        private var lastIndex = -1
        override fun hasNext(): Boolean = index != size
        override fun next${Type}(): ${Type} {
            if (index == size) throw NoSuchElementException()
            if (size != this@AbstractMutable${Type}List.size) throw ConcurrentModificationException()
            lastIndex = index++
            return get(lastIndex)
        }
        override fun remove() {
            check(lastIndex != -1)
            removeAt(lastIndex)
            index--
            lastIndex = -1
            --size
        }
    }

    private inner class ListTraverserImpl(position: Int) : Mutable${Type}ListTraverser {
        init {
            indexCheckInclusive(position)
        }

        private var size = this@AbstractMutable${Type}List.size
        private var index = position - 1

        override var position: Int = position
            private set
        override val value: ${Type} get() {
            check(index != -1)
            return get(index)
        }

        override fun forward(): Boolean {
            if (position == size) return false
            if (size != this@AbstractMutable${Type}List.size) throw ConcurrentModificationException()
            index = position++
            return true
        }

        override fun backward(): Boolean {
            if (position == 0) return false
            if (size != this@AbstractMutable${Type}List.size) throw ConcurrentModificationException()
            index = --position
            return true
        }

        override fun remove() {
            check(index != -1)
            removeAt(index)
            if (position > index) --position
            index = -1
            --size
        }

        override fun set(value: ${Type}) {
            check(index != -1)
            set(index, value)
        }

        override fun insert(value: ${Type}) {
            add(position, value)
            ++position
            index = -1
            ++size
        }
    }

    private open class ${Type}SubList(private val list: Mutable${Type}List, fromIndex: Int, toIndex: Int) : AbstractMutable${Type}List() {

        init {
            list.rangeCheck(fromIndex, toIndex)
        }

        private val offset = fromIndex
        final override var size = toIndex - fromIndex
            private set

        override fun set(index: Int, element: ${Type}) {
            return list.set(indexCheck(index) + offset, element)
        }

        override fun get(index: Int): ${Type} {
            return list[indexCheck(index) + offset]
        }

        override fun add(index: Int, element: ${Type}) {
            list.add(indexCheckInclusive(index) + offset, element)
            size++
        }

        override fun removeAt(index: Int): ${Type} {
            val result = list.removeAt(indexCheck(index) + offset)
            size--
            return result
        }

        override fun removeRange(fromIndex: Int, toIndex: Int) {
            rangeCheck(fromIndex, toIndex)
            list.removeRange(fromIndex + offset, toIndex + offset)
            size -= toIndex - fromIndex
        }

        override fun addAll(index: Int, elements: ${Type}Collection) {
            list.addAll(offset + indexCheckInclusive(index), elements)
            size += elements.size
        }

        override fun addAll(index: Int, elements: Collection<${Type}>) {
            list.addAll(offset + indexCheckInclusive(index), elements)
            size += elements.size
        }

        override fun copyInto(destination: ${Type}Array, destinationOffset: Int, fromIndex: Int, toIndex: Int): ${Type}Array {
            rangeCheck(fromIndex, toIndex)
            return list.copyInto(destination, destinationOffset, fromIndex + offset, toIndex + offset)
        }
    }

    private class RandomAccess${Type}SubList(list: Mutable${Type}List, fromIndex: Int, toIndex: Int) : ${Type}SubList(list, fromIndex, toIndex), RandomAccess
}

private object Empty${Type}ListTraverser : ${Type}ListTraverser {
    override val position: Int get() = 0
    override val value: ${Type} get() = throw IllegalStateException()
    override fun forward(): Boolean = false
    override fun backward(): Boolean = false
}

private object Empty${Type}List : Abstract${Type}List(), RandomAccess {
    override val size: Int get() = 0

    override fun isEmpty(): Boolean = true
    override fun contains(element: ${Type}): Boolean = false
    override fun containsAll(elements: Collection<${Type}>): Boolean = elements.isEmpty()
    override fun containsAll(elements: ${Type}Collection): Boolean = elements.isEmpty()

    override fun get(index: Int): ${Type} = throw IndexOutOfBoundsException()
    override fun indexOf(element: ${Type}): Int = -1
    override fun lastIndexOf(element: ${Type}): Int = -1

    override fun iterator(): ${Type}Iterator = empty${Type}Iterator()
    override fun traverser(): ${Type}Traverser = Empty${Type}ListTraverser
    override fun traverser(position: Int): ${Type}ListTraverser {
        indexCheckInclusive(position)
        return Empty${Type}ListTraverser
    }

    override fun subList(fromIndex: Int, toIndex: Int): ${Type}List {
        rangeCheck(fromIndex, toIndex)
        return Empty${Type}List
    }
}

private class Singleton${Type}List(private val value: ${Type}) : Abstract${Type}List(), RandomAccess {
    override val size: Int get() = 1

    override fun isEmpty(): Boolean = false
    override fun contains(element: ${Type}): Boolean = value equalsRaw element

    override fun get(index: Int): ${Type} = if (index == 0) value else throw IndexOutOfBoundsException()
    override fun indexOf(element: ${Type}): Int = if (element equalsRaw value) 0 else -1
    override fun lastIndexOf(element: ${Type}): Int = if (element equalsRaw value) 0 else -1

    override fun subList(fromIndex: Int, toIndex: Int): ${Type}List {
        rangeCheck(fromIndex, toIndex)
        return if (fromIndex == 0 && toIndex == 1) this else Empty${Type}List
    }
}

private class ${Type}ArrayListWrapper(private val array: ${Type}Array): Abstract${Type}List(), RandomAccess {
    override val size: Int get() = array.size
    override fun get(index: Int): ${Type} = array[index]

    override fun iterator(): ${Type}Iterator = object : ${Type}Iterator() {
        private var index = 0
        override fun hasNext(): Boolean = index < array.size
        override fun next${Type}(): ${Type} {
            if (index >= array.size) throw NoSuchElementException()
            return array[index++]
        }
    }

    override fun traverser(): ${Type}Traverser = object : ${Type}Traverser {
        private var index = -1
        override val value: ${Type} get() {
            check(index >= 0)
            return array[index]
        }
        override fun forward(): Boolean {
            if (index >= array.lastIndex) return false
            ++index
            return true
        }
    }

    override fun copyInto(destination: ${Type}Array, destinationOffset: Int, fromIndex: Int, toIndex: Int): ${Type}Array {
        rangeCheck(fromIndex, toIndex)
        destination.rangeCheck(destinationOffset, destinationOffset + toIndex - fromIndex)
        return array.copyInto(destination, destinationOffset, fromIndex, toIndex)
    }
}

private class ${Type}ListWrapper(private val list: ${Type}List) : AbstractList<${Type}>() {
    override val size: Int get() = list.size

    override fun get(index: Int) = list[index]
    override fun contains(element: ${Type}) = list.contains(element)

    override fun indexOf(element: ${Type}) = list.indexOf(element)
    override fun lastIndexOf(element: ${Type}) = list.lastIndexOf(element)

    override fun iterator(): Iterator<${Type}> = listIterator()
    override fun listIterator(): ListIterator<${Type}> = ListIteratorImpl(0)
    override fun listIterator(index: Int): ListIterator<${Type}> = ListIteratorImpl(index)

    private inner class ListIteratorImpl(position: Int): ListIterator<${Type}> {
        private val size = list.size
        private val traverser = list.traverser(position)

        override fun hasNext(): Boolean {
            if (list.size != size) throw ConcurrentModificationException()
            return traverser.position != size
        }
        override fun next(): ${Type} {
            if (!hasNext()) throw NoSuchElementException()
            traverser.forward()
            return traverser.value
        }
        override fun hasPrevious(): Boolean {
            if (list.size != size) throw ConcurrentModificationException()
            return traverser.position != 0
        }
        override fun previous(): ${Type} {
            if (!hasPrevious()) throw NoSuchElementException()
            traverser.backward()
            return traverser.value
        }
        override fun nextIndex(): Int = traverser.position
        override fun previousIndex(): Int = traverser.position - 1
    }
}

private class Mutable${Type}ListWrapper(private val list: Mutable${Type}List) : AbstractMutableList<${Type}>() {
    override val size: Int get() = list.size

    override fun get(index: Int) = list[index]
    override fun contains(element: ${Type}) = list.contains(element)

    override fun indexOf(element: ${Type}) = list.indexOf(element)
    override fun lastIndexOf(element: ${Type}) = list.lastIndexOf(element)

    override fun iterator(): MutableIterator<${Type}> = listIterator()
    override fun listIterator(): MutableListIterator<${Type}> = ListIteratorImpl(0)
    override fun listIterator(index: Int): MutableListIterator<${Type}> = ListIteratorImpl(index)

    override fun set(index: Int, element: ${Type}) = list.replace(index, element)

    override fun add(element: ${Type}) = list.add(element)
    override fun add(index: Int, element: ${Type}) = list.add(index, element)

    override fun remove(element: ${Type}): Boolean = list.remove(element)
    override fun removeAt(index: Int): ${Type} = list.removeAt(index)
    override fun removeRange(fromIndex: Int, toIndex: Int) = list.removeRange(fromIndex, toIndex)

    override fun clear() = list.clear()

    override fun subList(fromIndex: Int, toIndex: Int): MutableList<${Type}> = list.subList(fromIndex, toIndex).asList()

    private inner class ListIteratorImpl(position: Int): MutableListIterator<${Type}> {
        private var size = list.size
        private val traverser = list.traverser(position)

        override fun hasNext(): Boolean {
            if (list.size != size) throw ConcurrentModificationException()
            return traverser.position != size
        }
        override fun next(): ${Type} {
            if (!hasNext()) throw NoSuchElementException()
            traverser.forward()
            return traverser.value
        }
        override fun hasPrevious(): Boolean {
            if (list.size != size) throw ConcurrentModificationException()
            return traverser.position != 0
        }
        override fun previous(): ${Type} {
            if (!hasPrevious()) throw NoSuchElementException()
            traverser.backward()
            return traverser.value
        }
        override fun nextIndex(): Int = traverser.position
        override fun previousIndex(): Int = traverser.position - 1
        override fun remove() {
            traverser.remove()
            --size
        }
        override fun set(element: ${Type}) = traverser.set(element)
        override fun add(element: ${Type}) {
            traverser.insert(element)
            ++size
        }
    }
}
