/**
 * Methods for dealing with ${Type}Lists.
 */
@file:JvmName("${Type}Lists")
@file:JvmMultifileClass

package io.github.sooniln.fastcollect

import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
import kotlin.jvm.JvmMultifileClass
import kotlin.jvm.JvmName
import kotlin.jvm.JvmOverloads
import kotlin.jvm.JvmSynthetic
import kotlin.random.Random

public fun empty${Type}List(): ${Type}List = Empty${Type}List

public fun ${lowerType}ListOf(): ${Type}List = Empty${Type}List
public fun ${lowerType}ListOf(element: ${Type}): ${Type}List = Singleton${Type}List(element)
public fun ${lowerType}ListOf(vararg elements: ${Type}): ${Type}List = ${Type}ArrayDeque.wrap(elements)

public fun mutable${Type}ListOf(): Mutable${Type}List = ${Type}ArrayDeque()
public fun mutable${Type}ListOf(element: ${Type}): Mutable${Type}List = ${Type}ArrayDeque(1).apply { add(element) }
public fun mutable${Type}ListOf(vararg elements: ${Type}): Mutable${Type}List = ${Type}ArrayDeque.wrap(elements)

public fun ${Type}Array.as${Type}List(): ${Type}List = ${Type}ArrayListWrapper(this)

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun build${Type}List(expectedSize: Int = 0, builderAction: Mutable${Type}List.() -> Unit): ${Type}List {
    contract { callsInPlace(builderAction, InvocationKind.EXACTLY_ONCE) }

    val list = ${Type}ArrayDeque(expectedSize)
    list.builderAction()
    return list
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}List(size: Int, init: (index: Int) -> ${Type}): ${Type}List {
    contract { callsInPlace(init, InvocationKind.UNKNOWN) }
    return Mutable${Type}List(size, init)
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun Mutable${Type}List(size: Int, init: (index: Int) -> ${Type}): Mutable${Type}List {
    contract { callsInPlace(init, InvocationKind.UNKNOWN) }

    val list = ${Type}ArrayDeque(size)
    repeat(size) { index -> list.add(init(index)) }
    return list
}

/**
 * A random-access list of ${Type}s.
 */
public interface ${Type}List : ${Type}Collection, RandomAccess {

    public fun listIterator(): ${Type}ListIterator = listIterator(0)
    public fun listIterator(index: Int): ${Type}ListIterator

    override fun contains(element: ${Type}): Boolean {
        return indexOf(element) != -1
    }

    public operator fun get(index: Int): ${Type}

    public fun first(): ${Type} = if (isEmpty()) throw NoSuchElementException() else get(0)

    public fun last(): ${Type} = if (isEmpty()) throw NoSuchElementException() else get(lastIndex)

    public fun indexOf(element: ${Type}): Int {
        for (index in 0..<size) {
            val e = get(index)
            if (e equalsRaw element) {
                return index
            }
        }
        return -1
    }

    public fun lastIndexOf(element: ${Type}): Int {
        for (index in (size - 1) downTo 0) {
            val e = get(index)
            if (e equalsRaw element) {
                return index
            }
        }
        return -1
    }

    public fun subList(fromIndex: Int, toIndex: Int): ${Type}List

    override fun copyInto(destination: ${Type}Array, destinationOffset: Int): ${Type}Array {
        return copyInto(destination, destinationOffset, 0, size)
    }

    /**
     * Copies the elements of this list in the range [[fromIndex], [toIndex]) into [destination], starting at
     * [destinationOffset], and returns [destination]. Throw [IndexOutOfBoundsException] if [destination] does not have
     * enough room for all elements in the given range.
     */
    public fun copyInto(destination: ${Type}Array, destinationOffset: Int, fromIndex: Int, toIndex: Int): ${Type}Array {
        rangeCheck(fromIndex, toIndex)
        val destinationToIndex = destinationOffset + toIndex - fromIndex
        destination.rangeCheck(destinationOffset, destinationToIndex)

        var destinationIndex = destinationOffset
        var index = fromIndex
        while (destinationIndex < destinationToIndex) {
            destination[destinationIndex++] = get(index++)
        }
        return destination
    }
}

public val ${Type}List.lastIndex: Int @JvmSynthetic inline get() = size - 1

public fun ${Type}List.indexCheck(index: Int): Int {
    if (index !in 0..<size) throw IndexOutOfBoundsException("index=\$index, size=\$size")
    return index
}

public fun ${Type}List.indexCheckInclusive(index: Int): Int {
    if (index !in 0..size) throw IndexOutOfBoundsException("index=\$index, size=\$size")
    return index
}

public fun ${Type}List.rangeCheck(fromIndex: Int, toIndex: Int) {
    require(fromIndex <= toIndex)
    if (fromIndex < 0) throw IndexOutOfBoundsException("fromIndex=\$fromIndex")
    if (toIndex > size) throw IndexOutOfBoundsException("toIndex=\$toIndex, size=\$size")
}

@JvmOverloads
public fun ${Type}List.binarySearch(element: ${Type}, fromIndex: Int = 0, toIndex: Int = size): Int {
    rangeCheck(fromIndex, toIndex)

    var low = fromIndex
    var high = toIndex - 1

    while (low <= high) {
        val mid = low + (high - low) / 2
        val c = element.compareTo(get(mid))

        if (c > 0) {
            low = mid + 1
        } else if (c < 0) {
            high = mid - 1
        } else {
            return mid
        }
    }
    return -(low + 1)
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun <R> ${Type}List.foldRight(initial: R, operation: (accumulator: R, ${Type}) -> R): R {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }
    var accumulator = initial
    var index = size - 1
    while (index >= 0) {
        accumulator = operation(accumulator, get(index--))
    }
    return accumulator
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}List.reduceRight(operation: (accumulator: ${Type}, ${Type}) -> ${Type}): ${Type} {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }
    if (isEmpty()) throw NoSuchElementException()
    var index = size - 1
    var accumulator = get(index--)
    while (index >= 0) {
        accumulator = operation(accumulator, get(index--))
    }
    return accumulator
}

public fun ${Type}List.asList(): List<$Type> = ${Type}ListWrapper(this)

/**
 * A mutable list of ${Type}s.
 */
public interface Mutable${Type}List : ${Type}List, Mutable${Type}Collection {

    override fun listIterator(): Mutable${Type}ListIterator = listIterator(0)
    override fun listIterator(index: Int): Mutable${Type}ListIterator

    public operator fun set(index: Int, element: ${Type})

    public fun replace(index: Int, element: ${Type}): ${Type} {
        val t = get(index)
        set(index, element)
        return t
    }

    override fun add(element: ${Type}): Boolean {
        addLast(element)
        return true
    }

    public fun add(index: Int, element: ${Type})

    public fun addFirst(element: ${Type}): Unit = add(0, element)
    public fun addLast(element: ${Type}): Unit = add(size, element)
    public fun removeFirst(): ${Type} = if (isEmpty()) throw NoSuchElementException() else removeAt(0)
    public fun removeLast(): ${Type} = if (isEmpty()) throw NoSuchElementException() else removeAt(lastIndex)

    override fun remove(element: ${Type}): Boolean {
        val index = indexOf(element)
        if (index == -1) {
            return false
        } else {
            removeAt(index)
            return true
        }
    }

    public fun removeAt(index: Int): ${Type}

    public fun removeRange(fromIndex: Int, toIndex: Int)

    override fun clear(): Unit = removeRange(0, size)

    override fun addAll(elements: ${Type}Collection): Boolean {
        for (element in elements) {
            addLast(element)
        }
        return !elements.isEmpty()
    }

    override fun addAll(elements: Collection<${Type}>): Boolean {
        for (element in elements) {
            addLast(element)
        }
        return !elements.isEmpty()
    }

    public fun addAll(index: Int, elements: ${Type}Collection): Boolean {
        var i = indexCheckInclusive(index)
        for (element in elements) {
            add(i++, element)
        }
        return !elements.isEmpty()
    }

    public fun addAll(index: Int, elements: Collection<${Type}>): Boolean {
        var i = indexCheckInclusive(index)
        for (element in elements) {
            add(i++, element)
        }
        return !elements.isEmpty()
    }

    public fun sort() {
        val sorted = toArray().also { it.sort() }
        for (index in 0..<sorted.size) {
            set(index, sorted[index])
        }
    }

    public fun sortDescending() {
        val sorted = toArray().also { it.sortDescending() }
        for (index in 0..<sorted.size) {
            set(index, sorted[index])
        }
    }

    public fun fill(element: ${Type}) {
        for (index in 0..<size) {
            set(index, element)
        }
    }

    @JvmSynthetic
    public fun shuffle(random: Random) {
        for (i in lastIndex downTo 1) {
            val j = random.nextInt(i + 1)
            val tmp = get(i)
            set(i, get(j))
            set(j, tmp)
        }
    }

    public fun shuffle() { shuffle(Random) }

    public fun reverse() {
        val midPoint = (size / 2)
        var j = size - 1
        for (i in 0..<midPoint) {
            val tmp = get(i)
            set(i, get(j))
            set(j, tmp)
            --j
        }
    }

    override fun subList(fromIndex: Int, toIndex: Int): Mutable${Type}List
}

public fun Mutable${Type}List.asList(): MutableList<$Type> = Mutable${Type}ListWrapper(this)

public abstract class Abstract${Type}List : Abstract${Type}Collection(), ${Type}List {

    override fun iterator(): ${Type}Iterator = IteratorImpl()
    override fun listIterator(index: Int): ${Type}ListIterator = ListIteratorImpl(index)

    override fun subList(fromIndex: Int, toIndex: Int): ${Type}List = ${Type}SubList(this, fromIndex, toIndex)

    override fun equals(other: Any?): Boolean {
        if (other === this) return true
        if (other !is ${Type}List) return false
        if (size != other.size) return false

        for (i in 0..<size) {
            if (this[i] notEqualsRaw other[i]) {
                return false
            }
        }
        return true
    }

    override fun hashCode(): Int {
        var hashCode = 1
        for (element in this) {
            hashCode = 31 * hashCode + element.hashCode()
        }
        return hashCode
    }

    private inner class IteratorImpl: ${Type}Iterator() {
        private val size = this@Abstract${Type}List.size
        private var index = 0

        override fun hasNext(): Boolean = index < size
        override fun next${Type}(): ${Type} {
            if (index >= size) throw NoSuchElementException()
            if (size != this@Abstract${Type}List.size) throw ConcurrentModificationException()
            return get(index++)
        }
    }

    private inner class ListIteratorImpl(private var position: Int) : ${Type}ListIterator() {
        init {
            indexCheckInclusive(position)
        }

        private val size = this@Abstract${Type}List.size

        override fun hasNext(): Boolean = position < size

        override fun next${Type}(): ${Type} {
            if (position >= size) throw NoSuchElementException()
            if (size != this@Abstract${Type}List.size) throw ConcurrentModificationException()
            return get(position++)
        }

        override fun hasPrevious(): Boolean = position > 0

        override fun previous${Type}(): ${Type} {
            if (position <= 0) throw NoSuchElementException()
            if (size != this@Abstract${Type}List.size) throw ConcurrentModificationException()
            return get(--position)
        }

        override fun nextIndex(): Int = position
        override fun previousIndex(): Int = position - 1
    }

    private class ${Type}SubList(private val list: ${Type}List, fromIndex: Int, toIndex: Int) : Abstract${Type}List() {

        init {
            list.rangeCheck(fromIndex, toIndex)
        }

        private val offset = fromIndex
        override var size = toIndex - fromIndex
            protected set

        override fun get(index: Int): ${Type} {
            indexCheck(index)
            return list[index + offset]
        }

        override fun copyInto(destination: ${Type}Array, destinationOffset: Int, fromIndex: Int, toIndex: Int): ${Type}Array {
            rangeCheck(fromIndex, toIndex)
            return list.copyInto(destination, destinationOffset, fromIndex + offset, toIndex + offset)
        }
    }
}

public abstract class AbstractMutable${Type}List : Abstract${Type}List(), Mutable${Type}List {

    override fun iterator(): Mutable${Type}Iterator = IteratorImpl()
    override fun listIterator(index: Int): Mutable${Type}ListIterator = ListIteratorImpl(index)

    override fun removeRange(fromIndex: Int, toIndex: Int) {
        rangeCheck(fromIndex, toIndex)

        val iterator = listIterator(toIndex)
        repeat(toIndex-fromIndex) { _ ->
            iterator.previous${Type}()
            iterator.remove()
        }
    }

    override fun subList(fromIndex: Int, toIndex: Int): Mutable${Type}List = ${Type}SubList(this, fromIndex, toIndex)

    private inner class IteratorImpl: Mutable${Type}Iterator() {
        private var size = this@AbstractMutable${Type}List.size
        private var index = 0
        private var lastIndex = -1
        override fun hasNext(): Boolean = index != size
        override fun next${Type}(): ${Type} {
            if (index == size) throw NoSuchElementException()
            if (size != this@AbstractMutable${Type}List.size) throw ConcurrentModificationException()
            lastIndex = index++
            return get(lastIndex)
        }
        override fun remove() {
            check(lastIndex != -1)
            removeAt(lastIndex)
            index--
            lastIndex = -1
            --size
        }
    }

    private inner class ListIteratorImpl(private var position: Int) : Mutable${Type}ListIterator() {
        init {
            indexCheckInclusive(position)
        }

        private var size = this@AbstractMutable${Type}List.size
        private var index = -1

        override fun hasNext(): Boolean = position != size

        override fun next${Type}(): ${Type} {
            if (position == size) throw NoSuchElementException()
            if (size != this@AbstractMutable${Type}List.size) throw ConcurrentModificationException()
            index = position++
            return get(index)
        }

        override fun hasPrevious(): Boolean = position != 0

        override fun previous${Type}(): ${Type} {
            if (position == 0) throw NoSuchElementException()
            if (size != this@AbstractMutable${Type}List.size) throw ConcurrentModificationException()
            index = --position
            return get(index)
        }

        override fun nextIndex(): Int = position
        override fun previousIndex(): Int = position - 1

        override fun remove() {
            check(index != -1)
            removeAt(index)
            if (position > index) --position
            index = -1
            --size
        }

        override fun set(element: ${Type}) {
            check(index != -1)
            set(index, element)
        }

        override fun add(element: ${Type}) {
            add(position, element)
            ++position
            index = -1
            ++size
        }
    }

    private class ${Type}SubList(private val list: Mutable${Type}List, fromIndex: Int, toIndex: Int) : AbstractMutable${Type}List() {

        init {
            list.rangeCheck(fromIndex, toIndex)
        }

        private val offset = fromIndex
        override var size = toIndex - fromIndex
            private set

        override fun set(index: Int, element: ${Type}) {
            return list.set(indexCheck(index) + offset, element)
        }

        override fun get(index: Int): ${Type} {
            return list[indexCheck(index) + offset]
        }

        override fun add(index: Int, element: ${Type}) {
            list.add(indexCheckInclusive(index) + offset, element)
            size++
        }

        override fun removeAt(index: Int): ${Type} {
            val result = list.removeAt(indexCheck(index) + offset)
            size--
            return result
        }

        override fun removeRange(fromIndex: Int, toIndex: Int) {
            rangeCheck(fromIndex, toIndex)
            list.removeRange(fromIndex + offset, toIndex + offset)
            size -= toIndex - fromIndex
        }

        override fun addAll(index: Int, elements: ${Type}Collection): Boolean {
            list.addAll(offset + indexCheckInclusive(index), elements)
            size += elements.size
            return !elements.isEmpty()
        }

        override fun addAll(index: Int, elements: Collection<${Type}>): Boolean {
            list.addAll(offset + indexCheckInclusive(index), elements)
            size += elements.size
            return !elements.isEmpty()
        }

        override fun copyInto(destination: ${Type}Array, destinationOffset: Int, fromIndex: Int, toIndex: Int): ${Type}Array {
            rangeCheck(fromIndex, toIndex)
            return list.copyInto(destination, destinationOffset, fromIndex + offset, toIndex + offset)
        }
    }
}

private object Empty${Type}ListIterator : ${Type}ListIterator() {
    override fun hasNext(): Boolean = false
    override fun next${Type}(): ${Type} = throw NoSuchElementException()
    override fun hasPrevious(): Boolean = false
    override fun previous${Type}(): ${Type} = throw NoSuchElementException()
    override fun nextIndex(): Int = 0
    override fun previousIndex(): Int = -1
}

private object Empty${Type}List : Abstract${Type}List() {
    override val size: Int get() = 0

    override fun isEmpty(): Boolean = true
    override fun contains(element: ${Type}): Boolean = false
    override fun containsAll(elements: Collection<${Type}>): Boolean = elements.isEmpty()
    override fun containsAll(elements: ${Type}Collection): Boolean = elements.isEmpty()

    override fun get(index: Int): ${Type} = throw IndexOutOfBoundsException()
    override fun indexOf(element: ${Type}): Int = -1
    override fun lastIndexOf(element: ${Type}): Int = -1

    override fun iterator(): ${Type}Iterator = empty${Type}Iterator()
    override fun listIterator(index: Int): ${Type}ListIterator {
        indexCheckInclusive(index)
        return Empty${Type}ListIterator
    }

    override fun subList(fromIndex: Int, toIndex: Int): ${Type}List {
        rangeCheck(fromIndex, toIndex)
        return Empty${Type}List
    }
}

private class Singleton${Type}List(private val value: ${Type}) : Abstract${Type}List() {
    override val size: Int get() = 1

    override fun isEmpty(): Boolean = false
    override fun contains(element: ${Type}): Boolean = value equalsRaw element

    override fun get(index: Int): ${Type} = if (index == 0) value else throw IndexOutOfBoundsException()
    override fun indexOf(element: ${Type}): Int = if (element equalsRaw value) 0 else -1
    override fun lastIndexOf(element: ${Type}): Int = if (element equalsRaw value) 0 else -1

    override fun subList(fromIndex: Int, toIndex: Int): ${Type}List {
        rangeCheck(fromIndex, toIndex)
        return if (fromIndex == 0 && toIndex == 1) this else Empty${Type}List
    }
}

private class ${Type}ArrayListWrapper(private val array: ${Type}Array): Abstract${Type}List() {
    override val size: Int get() = array.size
    override fun get(index: Int): ${Type} = array[index]

    override fun iterator(): ${Type}Iterator = object : ${Type}Iterator() {
        private var index = 0
        override fun hasNext(): Boolean = index < array.size
        override fun next${Type}(): ${Type} {
            if (index >= array.size) throw NoSuchElementException()
            return array[index++]
        }
    }

    override fun copyInto(destination: ${Type}Array, destinationOffset: Int, fromIndex: Int, toIndex: Int): ${Type}Array {
        rangeCheck(fromIndex, toIndex)
        destination.rangeCheck(destinationOffset, destinationOffset + toIndex - fromIndex)
        return array.copyInto(destination, destinationOffset, fromIndex, toIndex)
    }
}

private class ${Type}ListWrapper(private val list: ${Type}List) : AbstractList<${Type}>() {
    override val size: Int get() = list.size

    override fun get(index: Int) = list[index]
    override fun contains(element: ${Type}) = list.contains(element)

    override fun indexOf(element: ${Type}) = list.indexOf(element)
    override fun lastIndexOf(element: ${Type}) = list.lastIndexOf(element)

    override fun iterator(): Iterator<${Type}> = IteratorWrapper(list.iterator())
    override fun listIterator(): ListIterator<${Type}> = ListIteratorWrapper(list.listIterator())
    override fun listIterator(index: Int): ListIterator<${Type}> = ListIteratorWrapper(list.listIterator(index))

    // wrappers exist to remove mutable operations from the underlying types
    private class IteratorWrapper(iterator: Iterator<${Type}>): Iterator<${Type}> by iterator
    private class ListIteratorWrapper(iterator: ListIterator<${Type}>): ListIterator<${Type}> by iterator
}

private class Mutable${Type}ListWrapper(private val list: Mutable${Type}List) : AbstractMutableList<${Type}>() {
    override val size: Int get() = list.size

    override fun get(index: Int) = list[index]
    override fun contains(element: ${Type}) = list.contains(element)

    override fun indexOf(element: ${Type}) = list.indexOf(element)
    override fun lastIndexOf(element: ${Type}) = list.lastIndexOf(element)

    override fun iterator(): MutableIterator<${Type}> = list.iterator()
    override fun listIterator(index: Int): MutableListIterator<${Type}> = list.listIterator(index)

    override fun set(index: Int, element: ${Type}) = list.replace(index, element)

    override fun add(element: ${Type}) = list.add(element)
    override fun add(index: Int, element: ${Type}) = list.add(index, element)

    override fun remove(element: ${Type}): Boolean = list.remove(element)
    override fun removeAt(index: Int): ${Type} = list.removeAt(index)
    override fun removeRange(fromIndex: Int, toIndex: Int) = list.removeRange(fromIndex, toIndex)

    override fun clear() = list.clear()

    override fun subList(fromIndex: Int, toIndex: Int): MutableList<${Type}> = list.subList(fromIndex, toIndex).asList()
}
