@file:Suppress("UnusedImport")

package io.github.sooniln.fastcollect.${subpackage}

import io.github.sooniln.fastcollect.ArrayUtils
import io.github.sooniln.fastcollect.FastIterator
import io.github.sooniln.fastcollect.MutableFastIterator
import io.github.sooniln.fastcollect.${subpackage}.Mutable${KVType}Collection
import io.github.sooniln.fastcollect.${subpackage}.Mutable${KVType}Iterator
import kotlin.jvm.JvmOverloads
import kotlin.math.max
import kotlin.math.min
import java.lang.foreign.MemorySegment
import java.lang.foreign.ValueLayout
import java.nio.ByteOrder

/**
 * A [HashMap](https://en.wikipedia.org/wiki/Hash_table) implementation for storing ${KVType} to ${KVType}
 * relationships using Robin Hood hashing with a parallel PSL (Probe Sequence Length) [ByteArray].
 *
 * Each slot in the PSL array stores PSL+1 (displacement + 1) for occupied slots, or 0 for empty slots.
 * Using 0 as the empty sentinel means the JVM's default ByteArray zero-initialization is sufficient, and
 * the empty check is subsumed by the Robin Hood early-exit condition in SWAR without any extra mask term.
 * Valid stored values are 1..128 (PSL 0..127); 0 means empty.
 * This enables:
 * - O(1) amortized early exit during lookup: the first slot where stored PSL+1 < expected PSL+1
 *   terminates the search. Empty slots (stored=0) are always caught since 0 < any expected value >= 1.
 * - A positive filter during lookup: a key K with home h can only exist at slot h+i if pslArr[h+i] == i+1,
 *   so key comparisons are skipped for slots where PSL doesn't match.
 *
 * The [keys]/[values] mutable collections exposed by this class will throw [UnsupportedOperationException] on any
 * attempt to mutate the collection, EXCEPT that [MutableIterator.remove] will work as expected. Other mutation
 * operations should be made directly on the map rather than on the sub-collections.
 *
 * The entry [iterator] exposed by this class is a [FastIterator] - clients may not allow the returned entry to escape.
 * See the [FastIterator] documentation for more information.
 *
 * The [ensureCapacity]/[trimToSize] methods can be used to manage the size of the backing array.
 */
public class ${Name}HashMap @JvmOverloads constructor(
    capacity: Int = DEFAULT_INITIAL_CAPACITY,
    /** The default value should be the value that is ideally least likely to occur in the map. */
    private val defaultValue: ${KVType} = ${DefaultValue},
) : AbstractMutable${Name}Map() {

    init {
        require(capacity >= 0) { "Capacity must be >= 0" }
    }

    public constructor(map: ${Name}Map): this() { putAll(map) }

    public constructor(map: Map<${KVType}, ${KVType}>): this() { putAll(map) }

    private var kvArr = EMPTY_KV_ARRAY

    // parallel PSL array: pslArr[slot] == 0 means empty; stored value is PSL+1 (1..128 for PSL 0..127).
    // allocated as N + SWAR_WIDTH - 1 bytes; pslArr[N + j] == pslArr[j] for j in 0..<SWAR_WIDTH - 1 (mirror region)
    private var pslArr = EMPTY_PSL_ARRAY
    private var pslArrSegment: MemorySegment = MemorySegment.ofArray(pslArr)

    // use threshold to store the initial size before we allocate anything, after that it's the size at which we rehash
    private var threshold: Int = if (capacity == 0) DEFAULT_INITIAL_CAPACITY else capacity

    override var size: Int = 0
        private set

    override fun isDefaultValue(value: ${KVType}): Boolean = value == defaultValue

    /**
     * Ensures that the map can hold at least given number of key/value pairs without any further resizing of the
     * backing array.
     */
    public fun ensureCapacity(capacity: Int) {
        require(capacity >= 0) { "The expected number of elements must be nonnegative" }
        if (kvArr === EMPTY_KV_ARRAY) {
            threshold = max(threshold, capacity)
        } else if (capacity > threshold) {
            rehash(capacity)
        }
    }

    /**
     * Reduces the size of the backing array to the minimum required to hold the current number of elements.
     */
    public fun trimToSize() {
        rehash(size)
    }

    override fun containsKey(key: ${KVType}): Boolean = findSlot(key, { _, _ -> true }, { false })

    override fun containsValue(value: ${KVType}): Boolean {
        val kvArr = kvArr
        val pslArr = pslArr
        for (slot in kvArr.indices) {
            if (kvArr[slot].value() == value && pslArr[slot].toInt() != 0) return true
        }
        return false
    }

    override fun get(key: ${KVType}): ${KVType} = findSlot(key, { _, entry -> entry.value() }, { defaultValue })

    override fun put(key: ${KVType}, value: ${KVType}): ${KVType} {
        resizeIfNecessary()

        val kvArr = kvArr
        val pslArr = pslArr
        val mask = kvArr.size - 1

        val n = kvArr.size
        var newEntry = arrayEntry(key, value)
        var slot = key.slot(mask)
        var newPsl: Byte = 1
        while (true) {
            val currPsl = pslArr[slot]
            if (currPsl.toInt() == 0) {
                kvArr[slot] = newEntry
                pslArr.writePsl(slot, newPsl, n)
                ++size
                return defaultValue
            }
            val currEntry = kvArr[slot]
            if (currEntry.key() == newEntry.key()) {
                val oldValue = currEntry.value()
                kvArr[slot] = newEntry
                // PSL is unchanged: same slot, same key
                return oldValue
            }
            // Robin Hood: steal from the richer entry (lower displacement)
            if (newPsl > currPsl) {
                kvArr[slot] = newEntry
                pslArr.writePsl(slot, newPsl, n)
                newEntry = currEntry
                newPsl = currPsl
            }
            slot = (slot + 1) and mask
            ++newPsl
        }
    }

    override fun remove(key: ${KVType}): ${KVType} {
        return findSlot(
            key,
            { slot, entry ->
                val oldValue = entry.value()
                removeSlot(slot)
                oldValue
            },
            { defaultValue })
    }

    override fun clear() {
        if (kvArr !== EMPTY_KV_ARRAY) {
            pslArr.fill(0)
        }
        size = 0
    }

    private inline fun <T> findSlot(key: ${KVType}, onFind: (slot: Int, entry: ${ArrayType}) -> T, onFail: () -> T): T {
        val pslArrSegment = pslArrSegment
        val kvArr = kvArr
        val mask = kvArr.size - 1

        var slot = key.slot(mask)
        // initial expected vector [1,2,3,4,5,6,7,8]: stored PSL+1 we'd expect at each lane for slotDistance=0
        var expectedLong = INC_VEC + BROADCAST_BYTE
        while (true) {
            val storedLong = pslArrSegment.get(LONG_LAYOUT, slot.toLong())
            val sub = (storedLong or MSB_MASK) - expectedLong

            // empty slots (stored=0) and slots with stored < expected both produce sub_i < 0x80 → bit 7 of sub.inv() set
            val earlyExit = sub.inv() and MSB_MASK

            val subFlipped = sub xor MSB_MASK
            var candidates = (subFlipped - BROADCAST_BYTE) and subFlipped.inv() and MSB_MASK
            while (candidates != 0L) {
                val index = (slot + (candidates.countTrailingZeroBits() ushr 3)) and mask
                val entry = kvArr[index]
                if (entry.key() == key) return onFind(index, entry)
                candidates = candidates and (candidates - 1)
            }

            if (earlyExit != 0L) return onFail()
            slot = (slot + SWAR_WIDTH) and mask
            expectedLong += EXPECTED_STEP
        }
    }

    private fun removeSlot(slot: Int) {
        val kvArr = kvArr
        val pslArr = pslArr
        val mask = kvArr.size - 1
        val n = kvArr.size

        // backward shift: pull each following entry one slot back while it has PSL > 0 (stored > 1)
        var currSlot = slot
        var nextSlot = (currSlot + 1) and mask
        while (pslArr[nextSlot] > 1) {
            kvArr[currSlot] = kvArr[nextSlot]
            pslArr.writePsl(currSlot, (pslArr[nextSlot] - 1).toByte(), n)
            currSlot = nextSlot
            nextSlot = (nextSlot + 1) and mask
        }
        pslArr.writePsl(currSlot, 0, n)
        --size
    }

    override fun putAll(from: ${Name}Map) {
        if (from is ${Name}HashMap && from.size / 2 > size) {
            val old = iterator()
            resetTo(from)
            for ((key, value) in old) {
                if (!containsKey(key)) set(key, value)
            }
        } else {
            ensureCapacity(max(size + (from.size / 2), from.size))
            for ((key, value) in from) {
                set(key, value)
            }
        }
    }

    override fun putAll(from: Map<out ${KVType}, ${KVType}>) {
        ensureCapacity(max(size + (from.size / 2), from.size))
        for ((key, value) in from) {
            set(key, value)
        }
    }

    private fun resetTo(from: ${Name}HashMap) {
        check(!from.isEmpty())

        kvArr = from.kvArr.copyOf()
        pslArr = from.pslArr.copyOf()
        pslArrSegment = MemorySegment.ofArray(pslArr)
        size = from.size
        threshold = from.threshold
    }

    private var _keys: Mutable${KVType}Set? = null
    override val keys: Mutable${KVType}Set get() {
        return _keys ?:
            object : Mutable${KVType}Set {
                override val size: Int get() = this@${Name}HashMap.size
                override fun contains(element: ${KVType}): Boolean = containsKey(element)
                override fun add(element: ${KVType}): Boolean = throw UnsupportedOperationException()
                override fun remove(element: ${KVType}): Boolean = throw UnsupportedOperationException()
                override fun iterator(): Mutable${KVType}Iterator = KeyIterator()
                override fun clear() = throw UnsupportedOperationException()
            }
            .also { _keys = it }
    }

    private var _values: Mutable${KVType}Collection? = null
    override val values: Mutable${KVType}Collection get() {
        return _values ?:
            object : Mutable${KVType}Collection {
                override val size: Int get() = this@${Name}HashMap.size
                override fun contains(element: ${KVType}): Boolean = containsValue(element)
                override fun add(element: ${KVType}): Boolean = throw UnsupportedOperationException()
                override fun remove(element: ${KVType}): Boolean = throw UnsupportedOperationException()
                override fun iterator(): Mutable${KVType}Iterator = ValueIterator()
                override fun clear() = throw UnsupportedOperationException()
            }
            .also { _values = it }
    }

    private fun resizeIfNecessary() {
        if (kvArr === EMPTY_KV_ARRAY) {
            rehash(threshold)
        } else if (size >= threshold) {
            rehash(threshold shl 1)
        }
    }

    @Suppress("UNCHECKED_CAST", "USELESS_CAST")
    private fun rehash(capacity: Int) {
        check(capacity >= size)

        if (capacity == 0) {
            if (kvArr !== EMPTY_KV_ARRAY) {
                kvArr = EMPTY_KV_ARRAY
                pslArr = EMPTY_PSL_ARRAY
                pslArrSegment = MemorySegment.ofArray(pslArr)
                threshold = DEFAULT_INITIAL_CAPACITY
            }
            return
        }

        // for small capacities we force loadFactor to 1.0 to save memory (small array scans are likely to be fast)
        val actualLoadFactor = if (capacity <= FORCE_LOAD_FACTOR_MAX) 1f else .9f

        val newLength = arraySize(capacity, actualLoadFactor)
        if (kvArr.size == newLength) return

        val newKvArr = ${ArrayType}Array(newLength)
        val newPslArr = ByteArray(newLength + SWAR_WIDTH - 1)  // zero-initialized; 0 means empty
        val newMask = newKvArr.size - 1

        val oldKvArr = kvArr
        val oldPslArr = pslArr
        for (slot in oldKvArr.indices) {
            if (oldPslArr[slot].toInt() != 0) putRehashing(newKvArr, newPslArr, newMask, oldKvArr[slot])
        }
        for (j in 0 ..< SWAR_WIDTH - 1) newPslArr[newLength + j] = newPslArr[j]

        kvArr = newKvArr
        pslArr = newPslArr
        pslArrSegment = MemorySegment.ofArray(pslArr)

        // threshold must always maintain the invariant of at least 1 slot being open
        val newCapacity = newLength / 2
        threshold = min((newCapacity * actualLoadFactor).toInt(), newCapacity - 1)
    }

    // assumes key doesn't exist in array
    private fun putRehashing(kvArr: ${ArrayType}Array, pslArr: ByteArray, mask: Int, entry: ${ArrayType}) {
        val n = mask + 1
        var slot = entry.key().slot(mask)
        var newEntry = entry
        var newPsl: Byte = 1
        while (true) {
            val currPsl = pslArr[slot]
            if (currPsl.toInt() == 0) {
                kvArr[slot] = newEntry
                pslArr.writePsl(slot, newPsl, n)
                return
            }
            if (newPsl > currPsl) {
                val tmpEntry = kvArr[slot]
                kvArr[slot] = newEntry
                pslArr.writePsl(slot, newPsl, n)
                newEntry = tmpEntry
                newPsl = currPsl
            }
            slot = (slot + 1) and mask
            ++newPsl
        }
    }

    override operator fun iterator(): MutableFastIterator<Mutable${Name}Map.MutableEntry> = FastEntryIterator()

    public fun forEach(action: (${KVType}, ${KVType}) -> Unit) {
        val kvArr = kvArr
        val pslArr = pslArr

        var slot = kvArr.size - 1
        while (slot >= 0) {
            if (pslArr[slot].toInt() != 0) {
                val entry = kvArr[slot]
                action(entry.key(), entry.value())
            }
            --slot
        }
    }

    private open inner class SlotIterator {
        private val kvArr = this@${Name}HashMap.kvArr
        private val pslArr = this@${Name}HashMap.pslArr
        private val mask = kvArr.size - 1

        private var slotsLeft = size
        private var slot = kvArr.size
        private var previousSlot = -1

        init {
            if (slotsLeft > 0) decrement()
        }

        fun hasNext(): Boolean {
            return slotsLeft > 0
        }

        fun nextSlot() {
            if (slotsLeft <= 0) throw NoSuchElementException()
            previousSlot = slot
            if (--slotsLeft > 0) decrement()
        }

        fun key(): ${KVType} = kvArr[previousSlot].key()
        fun value(): ${KVType} = kvArr[previousSlot].value()

        fun updateValue(newValue: ${KVType}) {
            check(previousSlot != -1)
            if (kvArr !== this@${Name}HashMap.kvArr) throw ConcurrentModificationException()
            kvArr[previousSlot] = arrayEntry(key(), newValue)
        }

        fun remove() {
            check(previousSlot != -1)
            if (kvArr !== this@${Name}HashMap.kvArr) throw ConcurrentModificationException()

            removeSlot(previousSlot)
            previousSlot = -1

            // if backward shift moved the entry at our next slot one position left, back up to follow it
            if (pslArr[slot].toInt() == 0) {
                slot = (slot - 1) and mask
            }
        }

        private fun decrement() {
            do {
                slot = (slot - 1) and mask
            } while (pslArr[slot].toInt() == 0)
        }
    }

    private inner class KeyIterator : Mutable${KVType}Iterator() {
        private val it = SlotIterator()

        override fun hasNext(): Boolean = it.hasNext()

        override fun next${KVType}(): ${KVType} {
            it.nextSlot()
            return it.key()
        }

        override fun remove() = it.remove()
    }

    private inner class ValueIterator : Mutable${KVType}Iterator() {
        private val it = SlotIterator()

        override fun hasNext(): Boolean = it.hasNext()

        override fun next${KVType}(): ${KVType} {
            it.nextSlot()
            return it.value()
        }

        override fun remove() = it.remove()
    }

    private inner class FastEntryIterator: SlotIterator(), MutableFastIterator<Mutable${Name}Map.MutableEntry>, Mutable${Name}Map.MutableEntry {

        override val key: ${KVType}
            get() = key()
        override var value: ${KVType}
            get() = value()
            set(value) {
                updateValue(value)
            }

        override fun next(): Mutable${Name}Map.MutableEntry {
            nextSlot()
            return this
        }

        override fun equals(other: Any?): Boolean = other is Map.Entry<*, *> && other.key == key && other.value == value
        override fun hashCode(): Int = key.hashCode() xor value.hashCode()
        override fun toString(): String = "\$key=\$value"
    }

    private fun ${KVType}.slot(mask: Int): Int {
        var h = hashCode()
        h = h xor (h ushr 16)
        h = h * PHI
        h = h xor (h ushr 16)
        return h and mask
    }

    private fun ${ArrayType}.key(): ${KVType} = to${KVType}()
    private fun ${ArrayType}.value(): ${KVType} = (this shr (8 * ${KVType}.SIZE_BYTES)).to${KVType}()
    private fun arrayEntry(key: ${KVType}, value: ${KVType}): ${ArrayType} = (value.to${ArrayType}() shl (8 * ${KVType}.SIZE_BYTES)) or (key.toLong() and 0xFFFFFFFFL)

    private fun ByteArray.writePsl(slot: Int, value: Byte, n: Int) {
        this[slot] = value
        if (slot < SWAR_WIDTH - 1) this[n + slot] = value
    }

    internal companion object {
        private val EMPTY_KV_ARRAY = ${lowerArrayType}ArrayOf(0.to${ArrayType}())

        private const val SWAR_WIDTH = Long.SIZE_BYTES

        // stored value 0 means empty; SWAR reads on an empty table (size=1) must be in-bounds
        private val EMPTY_PSL_ARRAY = ByteArray(SWAR_WIDTH)

        private const val BROADCAST_BYTE: Long = 0x0101010101010101L
        private const val INC_VEC:        Long = 0x0706050403020100L
        private const val MSB_MASK:       Long = BROADCAST_BYTE * 0x80L
        private const val EXPECTED_STEP:  Long = BROADCAST_BYTE * SWAR_WIDTH.toLong()
        private val LONG_LAYOUT = ValueLayout.JAVA_LONG_UNALIGNED.withOrder(ByteOrder.LITTLE_ENDIAN)

        private const val PHI: Int = 0x9E3779B9.toInt()

        internal const val DEFAULT_INITIAL_CAPACITY = 7

        private const val CACHE_LINE_SIZE = 64 / ${ArrayType}.SIZE_BYTES

        // we force the load factor to 1.0 up to the size of two cache lines
        private const val FORCE_LOAD_FACTOR_MAX: Int = 2 * CACHE_LINE_SIZE

        private fun arraySize(capacity: Int, loadFactor: Float): Int {
            check(capacity >= 0)
            // array must always maintain the invariant of at least one slot remaining open
            val requiredArraySize = 2 * max((capacity / loadFactor).toInt(), capacity + 1)
            return ArrayUtils.minPowerOfTwo(requiredArraySize)
        }
    }
}
