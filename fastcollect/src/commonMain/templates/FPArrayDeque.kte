package io.github.sooniln.fastcollect.${subpackage}

import io.github.sooniln.fastcollect.${lowerNonFPType}s.${NonFPType}ArrayDeque
import io.github.sooniln.fastcollect.${lowerNonFPType}s.${NonFPType}List
import io.github.sooniln.fastcollect.${lowerNonFPType}s.Mutable${NonFPType}List
import io.github.sooniln.fastcollect.${lowerNonFPType}s.Mutable${NonFPType}ListIterator
import io.github.sooniln.fastcollect.${lowerNonFPType}s.filterInPlace
import kotlin.jvm.JvmInline

public typealias ${Type}ArrayDeque = Inline${Type}ArrayDeque
public typealias ${Type}ArrayList = ${Type}ArrayDeque

@Suppress("OVERRIDE_BY_INLINE")
@JvmInline
public value class Inline${Type}ArrayDeque private constructor(@PublishedApi internal val list: ${NonFPType}ArrayDeque) : Mutable${Type}List {

    public constructor(capacity: Int = 0) : this(${NonFPType}ArrayDeque(capacity))
    public constructor(elements: ${Type}Collection) : this() { addAll(elements) }
    public constructor(elements: Collection<${Type}>) : this() { addAll(elements) }
    public constructor(elements: ${Type}Array, fromIndex:Int = 0, toIndex: Int = elements.size) : this(toIndex - fromIndex) { for (i in fromIndex..<toIndex) add(elements[i]) }

    override val size: Int
        inline get() = list.size

    public fun ensureCapacity(capacity: Int) { list.ensureCapacity(capacity) }
    public fun trimToSize() { list.trimToSize() }

    override fun get(index: Int): ${Type} = ${Type}.fromBits(list[index])
    override fun set(index: Int, element: ${Type}) { list[index] = element.toBits() }
    override fun addFirst(element: ${Type}) { list.addFirst(element.toBits()) }
    override fun addLast(element: ${Type}) { list.addLast(element.toBits()) }
    override fun add(index: Int, element: ${Type}) { list.add(index, element.toBits()) }
    override fun removeFirst(): ${Type} = ${Type}.fromBits(list.removeFirst())
    override fun removeLast(): ${Type} = ${Type}.fromBits(list.removeLast())
    override fun removeAt(index: Int): ${Type} = ${Type}.fromBits(list.removeAt(index))
    override fun removeRange(fromIndex: Int, toIndex: Int) { list.removeRange(fromIndex, toIndex) }
    override fun clear() { list.clear() }
    override fun indexOf(element: ${Type}): Int = list.indexOf(element.toBits())
    override fun lastIndexOf(element: ${Type}): Int = list.lastIndexOf(element.toBits())

    override fun addAll(elements: ${Type}Collection): Boolean {
        if (elements is Inline${Type}ArrayDeque) return list.addAll(elements.list)

        ensureCapacity(size + elements.size)
        for (element in elements) list.addLast(element.toBits())
        return !elements.isEmpty()
    }
    override fun addAll(elements: Collection<${Type}>): Boolean {
        if (elements is ${Type}Collection) return addAll(elements)

        ensureCapacity(size + elements.size)
        for (element in elements) list.addLast(element.toBits())
        return !elements.isEmpty()
    }
    override fun addAll(index: Int, elements: ${Type}Collection) {
        if (elements is Inline${Type}ArrayDeque) {
            list.addAll(index, elements.list)
        } else {
            ensureCapacity(size + elements.size)
            var i = index
            for (element in elements) list.add(i++, element.toBits())
        }
    }
    override fun addAll(index: Int, elements: Collection<${Type}>) {
        if (elements is ${Type}Collection) {
            addAll(index, elements)
        } else {
            ensureCapacity(size + elements.size)
            var i = index
            for (element in elements) list.add(i++, element.toBits())
        }
    }

    public override fun removeAll(elements: Collection<${Type}>): Boolean = list.filterInPlace { elements.contains(${Type}.fromBits(it)) }
    public override fun retainAll(elements: Collection<${Type}>): Boolean = list.filterInPlace { !elements.contains(${Type}.fromBits(it)) }

    override fun sort() { list.sort${Type}() }
    override fun sortDescending() { list.sortDescending${Type}() }
    override fun fill(element: ${Type}) { list.fill(element.toBits()) }
    override fun reverse() { list.reverse() }

    override fun iterator(): InlineMutable${Type}Iterator = InlineMutable${Type}Iterator(list.iterator())
    override fun listIterator(): InlineMutable${Type}ListIterator = InlineMutable${Type}ListIterator(list.listIterator())
    override fun listIterator(index: Int): InlineMutable${Type}ListIterator = InlineMutable${Type}ListIterator(list.listIterator(index))
    override fun subList(fromIndex: Int, toIndex: Int): Inline${Type}List = Inline${Type}List(list.subList(fromIndex, toIndex))

    override fun foreach(action: ${Type}Consumer) {
        list.foreach { element -> action.accept(${Type}.fromBits(element))}
    }

    override fun toString(): String = list.to${Type}ListString()
}

public fun Inline${Type}ArrayDeque.removeAll(predicate: ${Type}Predicate): Boolean = list.removeAll { predicate.test(${Type}.fromBits(it)) }
public fun Inline${Type}ArrayDeque.retainAll(predicate: ${Type}Predicate): Boolean = list.retainAll { predicate.test(${Type}.fromBits(it)) }

@Suppress("OVERRIDE_BY_INLINE")
@JvmInline
public value class Inline${Type}List internal constructor(@PublishedApi internal val list: Mutable${NonFPType}List) : Mutable${Type}List {

    override val size: Int
        inline get() = list.size

    override fun get(index: Int): ${Type} = ${Type}.fromBits(list[index])
    override fun set(index: Int, element: ${Type}) { list[index] = element.toBits() }
    override fun addFirst(element: ${Type}) { list.addFirst(element.toBits()) }
    override fun addLast(element: ${Type}) { list.addLast(element.toBits()) }
    override fun add(index: Int, element: ${Type}) { list.add(index, element.toBits()) }
    override fun removeFirst(): ${Type} = ${Type}.fromBits(list.removeFirst())
    override fun removeLast(): ${Type} = ${Type}.fromBits(list.removeLast())
    override fun removeAt(index: Int): ${Type} = ${Type}.fromBits(list.removeAt(index))
    override fun removeRange(fromIndex: Int, toIndex: Int) { list.removeRange(fromIndex, toIndex) }
    override fun clear() { list.clear() }
    override fun indexOf(element: ${Type}): Int = list.indexOf(element.toBits())
    override fun lastIndexOf(element: ${Type}): Int = list.lastIndexOf(element.toBits())

    public override fun removeAll(elements: Collection<${Type}>): Boolean = list.filterInPlace { elements.contains(${Type}.fromBits(it)) }
    public override fun retainAll(elements: Collection<${Type}>): Boolean = list.filterInPlace { !elements.contains(${Type}.fromBits(it)) }

    override fun sort() { list.sort${Type}() }
    override fun sortDescending() { list.sortDescending${Type}() }
    override fun fill(element: ${Type}) { list.fill(element.toBits()) }
    override fun reverse() { list.reverse() }

    override fun iterator(): InlineMutable${Type}Iterator = InlineMutable${Type}Iterator(list.iterator())
    override fun listIterator(): InlineMutable${Type}ListIterator = InlineMutable${Type}ListIterator(list.listIterator())
    override fun listIterator(index: Int): InlineMutable${Type}ListIterator = InlineMutable${Type}ListIterator(list.listIterator(index))
    override fun subList(fromIndex: Int, toIndex: Int): Inline${Type}List = Inline${Type}List(list.subList(fromIndex, toIndex))

    override fun toString(): String = list.to${Type}ListString()
}

public class InlineMutable${Type}ListIterator internal constructor(private val it: Mutable${NonFPType}ListIterator) : Mutable${Type}ListIterator() {
    override fun hasNext(): Boolean = it.hasNext()
    override fun hasPrevious(): Boolean = it.hasPrevious()
    override fun previous${Type}(): ${Type} = ${Type}.fromBits(it.previous${NonFPType}())
    override fun next${Type}(): ${Type} = ${Type}.fromBits(it.next${NonFPType}())
    override fun nextIndex(): Int = it.nextIndex()
    override fun previousIndex(): Int = it.previousIndex()
    override fun remove() { it.remove() }
    override fun set(element: ${Type}) { it.set(element.toBits()) }
    override fun add(element: ${Type}) { it.add(element.toBits()) }
}

private fun Mutable${NonFPType}List.sort${Type}() {
    // after sorting by integer representation, the negative values will be in reverse order - reverse them
    sort()

    // check the sign of the raw bits rather than the ${Type} value - the value comparison misses -0.0
    if (!isEmpty() && this[0] < 0) {
        // binary search for edge of negative values
        var left = 0
        var right = size
        while (left < right) {
            val mid = left + ((right - left) / 2)
            if (this[mid] < 0) left = mid + 1 else right = mid
        }

        right = left - 1
        left = 0
        while (left < right) {
            val tmp = this[left]
            this[left++] = this[right]
            this[right--] = tmp
        }
    }
}

private fun Mutable${NonFPType}List.sortDescending${Type}() {
    // after sorting by integer representation, the negative values will be in reverse order - reverse them
    sortDescending()

    // check the sign of the raw bits rather than the ${Type} value - the value comparison misses -0.0
    if (!isEmpty() && this[size - 1] < 0) {
        // binary search for edge of negative values
        var left = 0
        var right = size
        while (left < right) {
            val mid = left + ((right - left) / 2)
            if (this[mid] < 0) right = mid else left = mid + 1
        }

        right = size - 1
        while (left < right) {
            val tmp = this[left]
            this[left++] = this[right]
            this[right--] = tmp
        }
    }
}

private fun ${NonFPType}List.to${Type}ListString(): String = joinToString(", ", "[", "]") { ${Type}.fromBits(it).toString() }

