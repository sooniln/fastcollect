/**
 * Methods for dealing with ${Name}Traversables.
 */
@file:JvmName("${Name}Traversables")

package io.github.sooniln.fastcollect

import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
import kotlin.experimental.ExperimentalTypeInference
import kotlin.jvm.JvmName
import kotlin.jvm.JvmSynthetic

public fun ${Generics} empty${Name}Traverser(): ${Name}Traverser${Generics} = Empty${Name}Traverser

/**
 * A primitively typed [Traversable] of ${KeyType} to ${ValueType} tuples.
 */
public interface ${Name}Traversable${OutGenerics}: Traversable<${Name}Map.Entry${Generics}> {
    override fun traverser(): ${Name}Traverser${Generics}
}

/**
 * A primitively typed [MutableTraversable] of ${KeyType} to ${ValueType} tuples.
 */
public interface Mutable${Name}Traversable${Generics}: MutableTraversable<${Name}Map.Entry${Generics}>, ${Name}Traversable${Generics} {
    override fun traverser(): Mutable${Name}Traverser${Generics}
}

/**
 * A primitively typed [Traverser] of ${KeyType} to ${ValueType} tuples.
 */
public interface ${Name}Traverser${OutGenerics}: Traverser<${Name}Map.Entry${Generics}> {
    public val key: ${KeyType}
    public val value: ${ValueType}

    /** DO NOT USE. May cause boxing. */
    @Deprecated(level = DeprecationLevel.HIDDEN, message = "May cause boxing.")
    @get:JvmSynthetic
    override val element: ${Name}Map.Entry${Generics} get() = object: ${Name}Map.AbstractEntry${Generics}() {
        override val key: ${KeyType} get() = this@${Name}Traverser.key
        override val value: ${ValueType} get() = this@${Name}Traverser.value
    }
}
/**
 * A primitively typed [MutableTraverser] of ${KeyType} to ${ValueType} tuples.
 */
public interface Mutable${Name}Traverser${Generics} : ${Name}Traverser${Generics}, MutableTraverser<${Name}Map.Entry${Generics}> {
    override var value: ${ValueType}

    /** DO NOT USE. May cause boxing. */
    @Deprecated(level = DeprecationLevel.HIDDEN, message = "May cause boxing.")
    @get:JvmSynthetic
    override val element: Mutable${Name}Map.MutableEntry${Generics} get() = object: Mutable${Name}Map.AbstractMutableEntry${Generics}() {
        override val key: ${KeyType} get() = this@Mutable${Name}Traverser.key
        override var value: ${ValueType}
            get() = this@Mutable${Name}Traverser.value
            set(value) { this@Mutable${Name}Traverser.value = value }
    }
}

public fun ${Generics} ${Name}Traverser${Generics}.asKeyTraverser(): ${KeyType}Traverser {
    return object: ${KeyType}Traverser {
        override fun forward(): Boolean = this@asKeyTraverser.forward()
        override val value: ${KeyType} get() = key
    }
}

<% if (!isReferenceValue) { %>
public fun ${Generics} ${Name}Traverser${Generics}.asValueTraverser(): ${ValueType}Traverser {
    return object: ${ValueType}Traverser {
        override fun forward(): Boolean = this@asValueTraverser.forward()
        override val value: ${ValueType} get() = this@asValueTraverser.value
    }
}
<% } %>

@OptIn(ExperimentalContracts::class)
public inline fun ${Generics} ${Name}Traversable${Generics}.foreach(
    action: (${KeyType}, ${ValueType}) -> Unit
) {
    contract { callsInPlace(action, InvocationKind.UNKNOWN) }

    val traverser = traverser()
    while (traverser.forward()) {
        action(traverser.key, traverser.value)
    }
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Generics} ${Name}Traversable${Generics}.foreachKey(
    action: (${KeyType}) -> Unit
) {
    contract { callsInPlace(action, InvocationKind.UNKNOWN) }

    val traverser = traverser()
    while (traverser.forward()) {
        action(traverser.key)
    }
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Generics} ${Name}Traversable${Generics}.any(predicate: (${KeyType}, ${ValueType}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }

    foreach { key, value -> if (predicate(key, value)) return true }
    return false
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Generics} ${Name}Traversable${Generics}.all(predicate: (${KeyType}, ${ValueType}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return !any { key, value -> !predicate(key, value) }
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Generics} ${Name}Traversable${Generics}.none(predicate: (${KeyType}, ${ValueType}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return !any(predicate)
}

@OptIn(ExperimentalContracts::class)
<% if (isReferenceValue) { %>
public inline fun <R, V> ${Name}Traversable<V>.fold(initial: R, operation: (accumulated: R, ${KeyType}, ${ValueType}) -> R): R {
<% } else { %>
public inline fun <R> ${Name}Traversable.fold(initial: R, operation: (accumulated: R, ${KeyType}, ${ValueType}) -> R): R {
<% } %>
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }

    var accumulated = initial
    foreach { key, value -> accumulated = operation(accumulated, key, value) }
    return accumulated
}

@JvmName("intSumOf")
@OptIn(ExperimentalContracts::class, ExperimentalTypeInference::class)
@OverloadResolutionByLambdaReturnType
public inline fun ${Generics} ${Name}Traversable${Generics}.sumOf(selector: (${KeyType}, ${ValueType}) -> Int): Int {
    contract { callsInPlace(selector, InvocationKind.UNKNOWN) }

    var sum = 0
    foreach { key, value -> sum += selector(key, value) }
    return sum
}

@JvmName("longSumOf")
@OptIn(ExperimentalContracts::class, ExperimentalTypeInference::class)
@OverloadResolutionByLambdaReturnType
public inline fun ${Generics} ${Name}Traversable${Generics}.sumOf(selector: (${KeyType}, ${ValueType}) -> Long): Long {
    contract { callsInPlace(selector, InvocationKind.UNKNOWN) }

    var sum = 0L
    foreach { key, value -> sum += selector(key, value) }
    return sum
}

@JvmName("doubleSumOf")
@OptIn(ExperimentalContracts::class, ExperimentalTypeInference::class)
@OverloadResolutionByLambdaReturnType
public inline fun ${Generics} ${Name}Traversable${Generics}.sumOf(selector: (${KeyType}, ${ValueType}) -> Double): Double {
    contract { callsInPlace(selector, InvocationKind.UNKNOWN) }

    var sum = 0.0
    foreach { key, value -> sum += selector(key, value) }
    return sum
}

<% if (isReferenceValue) { %>
private object Empty${Name}Traverser : ${Name}Traverser<Nothing> {
<% } else { %>
private object Empty${Name}Traverser : ${Name}Traverser {
<% } %>
    override fun forward(): Boolean = false
    override val key: Nothing get() = throw IllegalStateException()
    override val value: Nothing get() = throw IllegalStateException()
}
