package io.github.sooniln.fastcollect.${subpackage}

import io.github.sooniln.fastcollect.assertBoxing

public fun empty${Type}Iterator(): ${Type}ListIterator = Empty${Type}Iterator

public abstract class Mutable${Type}Iterator : ${Type}Iterator(), MutableIterator<${Type}>

public abstract class ${Type}ListIterator: ${Type}Iterator(), ListIterator<${Type}> {
    final override fun previous(): ${Type} {
        assertBoxing()
        return previous${Type}()
    }
    public abstract fun previous${Type}(): ${Type}
}

public abstract class Mutable${Type}ListIterator: ${Type}ListIterator(), MutableListIterator<${Type}>

private object Empty${Type}Iterator : ${Type}ListIterator() {
    override fun previous${Type}(): ${Type} = throw NoSuchElementException()
    override fun next${Type}(): ${Type} = throw NoSuchElementException()

    override fun hasNext(): Boolean = false
    override fun hasPrevious(): Boolean = false

    override fun nextIndex(): Int = 0
    override fun previousIndex(): Int = -1
}
