/**
 * Methods for dealing with primitive Iterators.
 */
@file:JvmName("Iterators")
@file:JvmMultifileClass

package io.github.sooniln.fastcollect

import kotlin.jvm.JvmMultifileClass
import kotlin.jvm.JvmName

public fun empty${Type}Iterator(): Mutable${Type}Iterator = Empty${Type}Iterator
public fun ${lowerType}IteratorOf(value: ${Type}): ${Type}Iterator = Singleton${Type}Iterator(value)

public abstract class Mutable${Type}Iterator : ${Type}Iterator(), MutableIterator<${Type}>

private object Empty${Type}Iterator : Mutable${Type}Iterator() {
    override fun hasNext(): Boolean = false
    override fun next${Type}(): ${Type} = throw NoSuchElementException()
    override fun remove() = throw IllegalStateException()
}

private class Singleton${Type}Iterator(private val value: ${Type}) : ${Type}Iterator() {
    private var done = false

    override fun hasNext(): Boolean = !done
    override fun next${Type}(): ${Type} {
        if (done) throw NoSuchElementException()
        done = true
        return value
    }
}
