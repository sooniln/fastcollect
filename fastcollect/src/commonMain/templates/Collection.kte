/**
 * Methods for dealing with primitive Collections.
 */
@file:JvmName("Collections")
@file:JvmMultifileClass

package io.github.sooniln.fastcollect

import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
<% if (isFPType) { %>
import kotlin.jvm.JvmExposeBoxed
import kotlin.jvm.JvmInline
<% } %>
import kotlin.jvm.JvmMultifileClass
import kotlin.jvm.JvmName
import kotlin.jvm.JvmSynthetic

/**
 * A collection of ${Type}s.
 */
public interface ${Type}Collection {

    public val size: Int

    public fun isEmpty(): Boolean {
        return size == 0
    }

    public operator fun iterator(): ${Type}Iterator

    /**
     * A method for iteration guaranteed to be as fast or faster than [iterator].
     */
    public fun foreach(action: ${Type}Consumer) {
        val it = iterator()
        while (it.hasNext()) {
            action.accept(it.next())
        }
    }

    public fun contains(element: ${Type}): Boolean {
        for (e in this) {
            if (e equalsBoxed element) return true
        }
        return false
    }

    public fun containsAll(elements: ${Type}Collection): Boolean {
        for (e in elements) {
            if (!contains(e)) {
                return false
            }
        }
        return true
    }

    public fun containsAll(elements: Collection<${Type}>): Boolean {
        for (e in elements) {
            if (!contains(e)) {
                return false
            }
        }
        return true
    }

    public fun to${Type}Array(): ${Type}Array {
        val array = ${Type}Array(size)
        var index = 0
        for (element in this) {
            array[index++] = element
        }
        return array
    }
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.any(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }

    for (element in this) {
        if (predicate(element)) return true
    }
    return false
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.all(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return !any { !predicate(it) }
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.none(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return !any(predicate)
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun <R> ${Type}Collection.fold(initial: R, operation: (accumulated: R, ${Type}) -> R): R {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }

    var accumulated = initial
    for (element in this) {
        accumulated = operation(accumulated, element)
    }
    return accumulated
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.reduce(operation: (accumulated: ${Type}, ${Type}) -> ${Type}): ${Type} {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }

    val it = iterator()
    var accumulated = it.next${Type}()
    while (it.hasNext()) {
        accumulated = operation(accumulated, it.next${Type}())
    }
    return accumulated
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.sumOf(selector: (${Type}) -> Int): Int {
    contract { callsInPlace(selector, InvocationKind.UNKNOWN) }

    val it = iterator()
    var sum = 0
    while (it.hasNext()) {
        sum += selector(it.next${Type}())
    }
    return sum
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.sumOf(selector: (${Type}) -> Long): Long {
    contract { callsInPlace(selector, InvocationKind.UNKNOWN) }

    val it = iterator()
    var sum = 0L
    while (it.hasNext()) {
        sum += selector(it.next${Type}())
    }
    return sum
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.sumOf(selector: (${Type}) -> Double): Double {
    contract { callsInPlace(selector, InvocationKind.UNKNOWN) }

    val it = iterator()
    var sum = 0.0
    while (it.hasNext()) {
        sum += selector(it.next${Type}())
    }
    return sum
}

/**
 * A mutable collection of ${Type}s.
 */
public interface Mutable${Type}Collection : ${Type}Collection {
    override fun iterator(): Mutable${Type}Iterator

    public fun add(element: ${Type}): Boolean
    public fun remove(element: ${Type}): Boolean

    public fun clear() {
        val it = iterator()
        while (it.hasNext()) {
            it.next${Type}()
            it.remove()
        }
    }

    public fun addAll(elements: ${Type}Collection): Boolean {
        var modified = false
        for (e in elements) {
            modified = add(e) or modified
        }
        return modified
    }

    public fun addAll(elements: Collection<${Type}>): Boolean {
        var modified = false
        for (e in elements) {
            modified = add(e) or modified
        }
        return modified
    }

    public fun removeAll(elements: ${Type}Collection): Boolean = filterInPlace { elements.contains(it) }
    public fun removeAll(elements: Collection<${Type}>): Boolean = filterInPlace { elements.contains(it) }

    public fun retainAll(elements: ${Type}Collection): Boolean = filterInPlace { !elements.contains(it) }
    public fun retainAll(elements: Collection<${Type}>): Boolean = filterInPlace { !elements.contains(it) }

    public operator fun plusAssign(element: ${Type}) {
        add(element)
    }
    public operator fun plusAssign(elements: ${Type}Collection) {
        addAll(elements)
    }
    public operator fun plusAssign(elements: Collection<${Type}>) {
        addAll(elements)
    }

    public operator fun minusAssign(element: ${Type}) {
        remove(element)
    }
    public operator fun minusAssign(elements: ${Type}Collection) {
        removeAll(elements)
    }
    public operator fun minusAssign(elements: Collection<${Type}>) {
        removeAll(elements)
    }
}

@OptIn(ExperimentalContracts::class)
public inline fun Mutable${Type}Collection.removeAll(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }

    var modified = false
    val it = iterator()
    while (it.hasNext()) {
        if (predicate(it.next${Type}())) {
            it.remove()
            modified = true
        }
    }
    return modified
}

@OptIn(ExperimentalContracts::class)
public inline fun Mutable${Type}Collection.retainAll(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return removeAll { !predicate(it) }
}

@OptIn(ExperimentalContracts::class)
internal inline fun Mutable${Type}Collection.filterInPlace(removePredicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(removePredicate, InvocationKind.UNKNOWN) }

    var modified = false
    val it = iterator()
    while (it.hasNext()) {
        if (removePredicate(it.next${Type}())) {
            it.remove()
            modified = true
        }
    }
    return modified
}

public abstract class Abstract${Type}Collection : ${Type}Collection {
    override fun toString(): String {
        return Iterable { iterator() }.joinToString(", ", "[", "]")
    }
}

<% if (isFPType) { %>

@OptIn(ExperimentalStdlibApi::class)
@JvmExposeBoxed
@JvmInline
public value class Inline${Type}Collection public constructor(@PublishedApi internal val collection: Mutable${NonFPType}Collection) : Mutable${Type}Collection {
    override val size: Int get() = collection.size
    override fun contains(element: ${Type}): Boolean = collection.contains(element.toBits())
    override fun add(element: ${Type}): Boolean = collection.add(element.toBits())
    override fun remove(element: ${Type}): Boolean = collection.remove(element.toBits())
    override fun iterator(): InlineMutable${Type}Iterator = InlineMutable${Type}Iterator(collection.iterator())
    override fun foreach(action: ${Type}Consumer): Unit = collection.foreach { value -> action.accept(${Type}.fromBits(value)) }
}

public class InlineMutable${Type}Iterator public constructor(@PublishedApi internal val it: Mutable${NonFPType}Iterator) : Mutable${Type}Iterator() {
    override fun hasNext(): Boolean = it.hasNext()
    override fun next${Type}(): ${Type} = ${Type}.fromBits(it.next${NonFPType}())
    override fun remove() { it.remove() }
}

<% } %>

public fun interface ${Type}Consumer {
    public fun accept(value: ${Type})
}
