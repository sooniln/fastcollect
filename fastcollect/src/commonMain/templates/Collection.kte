package io.github.sooniln.fastcollect.${subpackage}

import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract

/**
 * A collection of ${Type}s which inherits from [Collection].
 */
public interface ${Type}Collection : Collection<${Type}> {
    override fun isEmpty(): Boolean {
        return size == 0
    }

    override fun iterator(): ${Type}Iterator

    override fun contains(element: ${Type}): Boolean {
        for (e in this) {
            if (e == element) return true
        }
        return false
    }

    public fun containsAll(elements: ${Type}Collection): Boolean {
        for (e in elements) {
            if (!contains(e)) {
                return false
            }
        }
        return true
    }

    override fun containsAll(elements: Collection<${Type}>): Boolean {
        if (elements is ${Type}Collection) {
            return containsAll(elements)
        }

        for (e in elements) {
            if (!contains(e)) {
                return false
            }
        }
        return true
    }

    public fun to${Type}Array(): ${Type}Array {
        val array = ${Type}Array(size)
        var index = 0
        for (element in this) {
            array[index++] = element
        }
        return array
    }
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.any(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }

    for (element in this) {
        if (predicate(element)) return true
    }
    return false
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.all(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return !any { !predicate(it) }
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.none(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return !any(predicate)
}

@OptIn(ExperimentalContracts::class)
public inline fun <R> ${Type}Collection.fold(initial: R, operation: (accumulated: R, ${Type}) -> R): R {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }

    var accumulated = initial
    for (element in this) {
        accumulated = operation(accumulated, element)
    }
    return accumulated
}

@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.reduce(operation: (accumulated: ${Type}, ${Type}) -> ${Type}): ${Type} {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }

    val it = iterator()
    var accumulated = it.next${Type}()
    while (it.hasNext()) {
        accumulated = operation(accumulated, it.next${Type}())
    }
    return accumulated
}

/**
 * A mutable collection of ${Type}s which inherits from [MutableCollection].
 */
public interface Mutable${Type}Collection : ${Type}Collection, MutableCollection<${Type}> {
    override fun iterator(): Mutable${Type}Iterator

    override fun add(element: ${Type}): Boolean
    override fun remove(element: ${Type}): Boolean

    override fun clear() {
        val it = iterator()
        while (it.hasNext()) {
            it.next${Type}()
            it.remove()
        }
    }

    public fun addAll(elements: ${Type}Collection): Boolean {
        var modified = false
        for (e in elements) {
            modified = add(e) or modified
        }
        return modified
    }

    override fun addAll(elements: Collection<${Type}>): Boolean {
        if (elements is ${Type}Collection) {
            return addAll(elements)
        }

        var modified = false
        for (e in elements) {
            modified = add(e) or modified
        }
        return modified
    }

    public fun removeAll(elements: ${Type}Collection): Boolean = filterInPlace { elements.contains(it) }
    override fun removeAll(elements: Collection<${Type}>): Boolean {
        return if (elements is ${Type}Collection) removeAll(elements) else filterInPlace { elements.contains(it) }
    }

    public fun retainAll(elements: ${Type}Collection): Boolean = filterInPlace { !elements.contains(it) }
    override fun retainAll(elements: Collection<${Type}>): Boolean {
        return if (elements is ${Type}Collection) retainAll(elements) else filterInPlace { !elements.contains(it) }
    }

    public operator fun plusAssign(element: ${Type}) {
        add(element)
    }
    public operator fun plusAssign(elements: ${Type}Collection) {
        addAll(elements)
    }
    public operator fun plusAssign(elements: Collection<${Type}>) {
        addAll(elements)
    }

    public operator fun minusAssign(element: ${Type}) {
        remove(element)
    }
    public operator fun minusAssign(elements: ${Type}Collection) {
        removeAll(elements)
    }
    public operator fun minusAssign(elements: Collection<${Type}>) {
        removeAll(elements)
    }
}

@OptIn(ExperimentalContracts::class)
public inline fun Mutable${Type}Collection.removeAll(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }

    var modified = false
    val it = iterator()
    while (it.hasNext()) {
        if (predicate(it.next${Type}())) {
            it.remove()
            modified = true
        }
    }
    return modified
}

@OptIn(ExperimentalContracts::class)
public inline fun Mutable${Type}Collection.retainAll(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return removeAll { !predicate(it) }
}

@OptIn(ExperimentalContracts::class)
private inline fun Mutable${Type}Collection.filterInPlace(removePredicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(removePredicate, InvocationKind.UNKNOWN) }

    var modified = false
    val it = iterator()
    while (it.hasNext()) {
        if (removePredicate(it.next${Type}())) {
            it.remove()
            modified = true
        }
    }
    return modified
}

public abstract class Abstract${Type}Collection : ${Type}Collection {
    override fun toString(): String {
        return joinToString(", ", "[", "]")
    }
}
