/**
 * Methods for dealing with ${Type}Collections.
 */
@file:JvmName("${Type}Collections")
@file:JvmMultifileClass

package io.github.sooniln.fastcollect

import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
import kotlin.jvm.JvmMultifileClass
import kotlin.jvm.JvmName
import kotlin.jvm.JvmOverloads
import kotlin.jvm.JvmSynthetic

/**
 * A collection of ${Type}s.
 */
@Suppress("INAPPLICABLE_JVM_NAME")
public interface ${Type}Collection {

    @get:JvmName("size")
    public val size: Int

    public fun isEmpty(): Boolean {
        return size == 0
    }

    public operator fun iterator(): ${Type}Iterator

    public fun contains(element: ${Type}): Boolean {
        for (e in this) {
            if (e equalsRaw element) return true
        }
        return false
    }

    public fun containsAll(elements: ${Type}Collection): Boolean {
        for (e in elements) {
            if (!contains(e)) {
                return false
            }
        }
        return true
    }

    public fun containsAll(elements: Collection<${Type}>): Boolean {
        for (e in elements) {
            if (!contains(e)) {
                return false
            }
        }
        return true
    }

    /**
     * Copies all of the elements of this collection into [destination], starting at [destinationOffset], and returns
     * [destination]. Throws [IndexOutOfBoundsException] if the [destination] is not large enough for all elements.
     */
    public fun copyInto(destination: ${Type}Array, destinationOffset: Int = 0): ${Type}Array {
        destination.rangeCheck(destinationOffset, destinationOffset + size)
        var index = destinationOffset
        for (element in this) {
            destination[index++] = element
        }
        return destination
    }

    /**
     * Returns a new array containing all elements in this collection.
     */
    public fun toArray(): ${Type}Array = copyInto(${Type}Array(size))
}

public fun ${Type}Collection.isNotEmpty(): Boolean = size != 0

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.any(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    for (element in this) {
        if (predicate(element)) return true
    }
    return false
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.all(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return !any { !predicate(it) }
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.none(predicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    return !any(predicate)
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.find(defaultValue: ${Type}, predicate: (${Type}) -> Boolean): ${Type} {
    contract { callsInPlace(predicate, InvocationKind.UNKNOWN) }
    for (element in this) {
        if (predicate(element)) return element
    }
    return defaultValue
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun <R> ${Type}Collection.fold(initial: R, operation: (accumulator: R, ${Type}) -> R): R {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }
    var accumulator = initial
    for (element in this) {
        accumulator = operation(accumulator, element)
    }
    return accumulator
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
public inline fun ${Type}Collection.reduce(operation: (accumulator: ${Type}, ${Type}) -> ${Type}): ${Type} {
    contract { callsInPlace(operation, InvocationKind.UNKNOWN) }
    val iterator = this.iterator()
    var accumulator = iterator.next()
    while (iterator.hasNext()) {
        accumulator = operation(accumulator, iterator.next())
    }
    return accumulator
}

@JvmSynthetic
public fun <A : Appendable> ${Type}Collection.joinTo(buffer: A, separator: CharSequence = ", ", prefix: CharSequence = "", postfix: CharSequence = "", transform: ((${Type}) -> CharSequence)? = null): A {
    buffer.append(prefix)
    var first = true
    for (element in this) {
        if (first) first = false else buffer.append(separator)
        buffer.append(if (transform == null) element.toString() else transform(element))
    }
    buffer.append(postfix)
    return buffer
}

@JvmOverloads
public fun ${Type}Collection.joinToString(separator: CharSequence = ", ", prefix: CharSequence = "", postfix: CharSequence = ""): String {
    return joinTo(StringBuilder(), separator, prefix, postfix, null).toString()
}

/**
 * A mutable collection of ${Type}s.
 */
public interface Mutable${Type}Collection : ${Type}Collection {
    override fun iterator(): Mutable${Type}Iterator

    public fun add(element: ${Type}): Boolean
    public fun remove(element: ${Type}): Boolean

    public fun clear() {
        val iterator = iterator()
        while (iterator.hasNext()) {
            iterator.next${Type}()
            iterator.remove()
        }
    }

    public fun addAll(elements: ${Type}Collection): Boolean {
        var modified = false
        for (element in elements) {
            modified = add(element) or modified
        }
        return modified
    }

    public fun addAll(elements: Collection<${Type}>): Boolean {
        var modified = false
        for (element in elements) {
            modified = add(element) or modified
        }
        return modified
    }

    public fun removeAll(elements: ${Type}Collection): Boolean = filterInPlace { elements.contains(it) }
    public fun removeAll(elements: Collection<${Type}>): Boolean = filterInPlace { elements.contains(it) }

    public fun retainAll(elements: ${Type}Collection): Boolean = filterInPlace { !elements.contains(it) }
    public fun retainAll(elements: Collection<${Type}>): Boolean = filterInPlace { !elements.contains(it) }

    public operator fun plusAssign(element: ${Type}) {
        add(element)
    }
    public operator fun plusAssign(elements: ${Type}Collection) {
        addAll(elements)
    }
    public operator fun plusAssign(elements: Collection<${Type}>) {
        addAll(elements)
    }

    public operator fun minusAssign(element: ${Type}) {
        remove(element)
    }
    public operator fun minusAssign(elements: ${Type}Collection) {
        removeAll(elements)
    }
    public operator fun minusAssign(elements: Collection<${Type}>) {
        removeAll(elements)
    }
}

@JvmSynthetic
@OptIn(ExperimentalContracts::class)
internal inline fun Mutable${Type}Collection.filterInPlace(removePredicate: (${Type}) -> Boolean): Boolean {
    contract { callsInPlace(removePredicate, InvocationKind.UNKNOWN) }

    var modified = false
    val iterator = iterator()
    while (iterator.hasNext()) {
        if (removePredicate(iterator.next${Type}())) {
            iterator.remove()
            modified = true
        }
    }
    return modified
}

public abstract class Abstract${Type}Collection : ${Type}Collection {
    override fun toString(): String = joinToString(", ", "[", "]")
}
