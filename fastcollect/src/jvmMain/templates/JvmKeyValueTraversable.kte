/**
 * Methods for dealing with ${Name}Traversables.
 */
@file:JvmName("${Name}Traversables")
@file:JvmMultifileClass

package io.github.sooniln.fastcollect

import kotlin.jvm.JvmMultifileClass

<% if (!isReferenceValue) { %>
public fun ${Name}Traversable.traverse(action: ${KeyType}${ValueType}Consumer): Unit = traverse { key, value -> action.accept(key, value) }
<% } else { %>
public fun <V> ${Name}Traversable<V>.traverse(action: ${KeyType}AnyConsumer<V>): Unit = traverse { key, value -> action.accept(key, value) }
<% } %>
public fun ${Generics} ${Name}Traversable${Generics}.traverseKeys(action: ${KeyType}Consumer): Unit = traverseKeys { key -> action.accept(key) }

