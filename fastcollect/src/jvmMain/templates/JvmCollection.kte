/**
 * Methods for dealing with ${Type}Collections.
 */
@file:JvmName("${Type}Collections")
@file:JvmMultifileClass

package io.github.sooniln.fastcollect

import kotlin.jvm.JvmMultifileClass

public fun ${Type}Collection.any(predicate: ${Type}Predicate): Boolean = any { predicate.test(it) }
public fun ${Type}Collection.all(predicate: ${Type}Predicate): Boolean = all { predicate.test(it) }
public fun ${Type}Collection.none(predicate: ${Type}Predicate): Boolean = none { predicate.test(it) }
public fun ${Type}Collection.find(defaultValue: ${Type}, predicate: ${Type}Predicate): ${Type} = find(defaultValue) { predicate.test(it) }
