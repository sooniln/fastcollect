package io.github.sooniln.fastcollect.${subpackage}

import kotlin.contracts.ExperimentalContracts
import kotlin.contracts.InvocationKind
import kotlin.contracts.contract
import kotlin.experimental.ExperimentalTypeInference

public fun empty${Type}Set(): ${Type}Set = Empty${Type}Set

public fun ${lowerType}SetOf(): ${Type}Set = Empty${Type}Set
public fun ${lowerType}SetOf(element: ${Type}): ${Type}Set = Singleton${Type}Set(element)
public fun ${lowerType}SetOf(vararg elements: ${Type}): ${Type}Set = ${Type}HashSet(elements.as${Type}List())

public fun mutable${Type}SetOf(): Mutable${Type}Set = ${Type}HashSet()
public fun mutable${Type}SetOf(element: ${Type}): Mutable${Type}Set = ${Type}HashSet(1).apply { add(element) }
public fun mutable${Type}SetOf(vararg elements: ${Type}): Mutable${Type}Set = ${Type}HashSet(elements.as${Type}List())

@OptIn(ExperimentalContracts::class, ExperimentalTypeInference::class)
public inline fun build${Type}Set(expectedSize: Int = 0, builderAction: Mutable${Type}Set.() -> Unit): ${Type}Set {
    contract { callsInPlace(builderAction, InvocationKind.EXACTLY_ONCE) }
    val list = ${Type}HashSet(expectedSize)
    list.builderAction()
    return list
}

public interface ${Type}Set : Set<${Type}>, ${Type}Collection {
    override fun isEmpty(): Boolean = super.isEmpty()

    override fun contains(element: ${Type}): Boolean {
        for (e in this) {
            if (e == element) return true
        }
        return false
    }

    override fun containsAll(elements: Collection<${Type}>): Boolean = super.containsAll(elements)
}

public interface Mutable${Type}Set : ${Type}Set, Mutable${Type}Collection

private object Empty${Type}Set : ${Type}Set {
    override val size: Int get() = 0

    override fun isEmpty(): Boolean = true
    override fun contains(element: ${Type}): Boolean = false
    override fun containsAll(elements: Collection<${Type}>): Boolean = elements.isEmpty()
    override fun containsAll(elements: ${Type}Collection): Boolean = elements.isEmpty()

    override fun iterator(): ${Type}Iterator = empty${Type}Iterator()
}

private class Singleton${Type}Set(private val value: ${Type}) : ${Type}Set {
    override val size: Int get() = 1

    override fun isEmpty(): Boolean = false
    override fun contains(element: ${Type}): Boolean = value == element

    override fun iterator(): ${Type}Iterator = object : ${Type}Iterator() {
        private var complete = false

        override fun next${Type}(): ${Type} {
            if (complete) throw NoSuchElementException()
            complete = true
            return value
        }

        override fun hasNext(): Boolean = !complete
    }
}